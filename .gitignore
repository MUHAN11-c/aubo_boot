*.py[cod]
*$py.class
*.so
*.so.*
.pytest_cache/
.eggs/
*.egg-info/
*.egg

# IDE / 编辑器
.cursor/
.idea/
.vscode/
.worktrees/
*.swp
*.swo

# 环境与本地配置
.env
.env.local
*.local


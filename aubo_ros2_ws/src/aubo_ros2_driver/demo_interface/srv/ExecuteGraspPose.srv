# ExecuteGraspPose.srv
# 执行抓取位姿服务

# Request
string object_id                    # 工件ID
bool use_visual_estimation          # 是否使用视觉估计（false=使用参数常量）
---
# Response
bool success                        # 是否成功
string message                      # 状态消息或错误信息
geometry_msgs/Point final_position      # 最终使用的抓取位置
geometry_msgs/Quaternion final_orientation  # 最终使用的抓取姿态

# 运动到目标位姿
geometry_msgs/Pose target_pose       # 目标TCP位姿（位置 + 四元数姿态）
float64[6] target_joints             # 目标关节角度（use_joints=true时使用）
bool use_joints                      # true=关节空间运动 / false=笛卡尔空间运动
float32 velocity_factor              # 速度倍率（0.0~1.0）
float32 acceleration_factor          # 加速度倍率（0.0~1.0）
---
bool success      # 运动是否成功
int32 error_code  # 错误码（0=成功）
string message    # 状态消息或错误信息

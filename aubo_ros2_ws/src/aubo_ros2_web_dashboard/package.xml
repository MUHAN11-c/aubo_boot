<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aubo_ros2_web_dashboard</name>
  <version>0.4.0</version>
  <description>
    IVG Web Dashboard: FastAPI 网关 (uvicorn) + 静态前端 (ROSLIB.js / Chart.js)。
    浏览器通过同源代理访问 rosbridge (/ws/rosbridge) 和 web_video_server (/api/ivg/proxy/web-video)。
  </description>
  <maintainer email="maintainer@example.com">IVG</maintainer>
  <license>Apache-2.0</license>


  <!-- ROS 2 运行时依赖 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosbridge_suite</exec_depend>
  <exec_depend>tf2_web_republisher</exec_depend>
  <exec_depend>tf2_web_republisher_interfaces</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>image_transport_plugins</exec_depend>
  <exec_depend>ivg_interfaces</exec_depend>

  <!-- 测试依赖 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

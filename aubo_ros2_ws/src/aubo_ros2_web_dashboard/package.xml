<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aubo_ros2_web_dashboard</name>
  <version>0.2.0</version>
  <description>
    IVG Web stack: rosbridge_suite + tf2_web_republisher + static hosting of the official
    RobotWebTools ros2-web-bridge demo (see web/ros2_web_bridge_demo, upstream Apache-2.0).
  </description>
  <maintainer email="maintainer@example.com">IVG</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rosapi</exec_depend>
  <exec_depend>tf2_web_republisher</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

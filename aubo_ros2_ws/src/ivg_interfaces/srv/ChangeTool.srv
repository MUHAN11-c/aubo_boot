# =============================================================================
# ChangeTool.srv — 切换工具服务
# 用途：在机器人末端更换/安装指定工具（夹爪/吸盘等），更新运动学参数和碰撞模型喵~
# 调用方：上位机任务调度节点、工具切换协调节点、工具管理节点
# 服务方：tool_changer_interface 的 gripper_swap_worker 节点
# 说明：与 RunGripperSwap 不同，此服务直接指定目标工具 ID 进行切换喵~
#       切换过程中会按以下步骤执行：
#       1. 调用 publishToolStatus(false) 清除当前工具的 PlanningScene 碰撞模型喵~
#       2. 更新 URDF 为无工具版本喵~
#       3. 设置新工具的 TCP 参数（SetToolKinematics）喵~
#       4. 设置工具电压（SetToolVoltage）喵~
#       5. 设置负载参数（SetPayload）喵~
#       6. 更新 URDF 为新工具版本并重载喵~
#       7. 发布新工具的碰撞模型到 PlanningScene喵~
# =============================================================================

# ======================== 请求字段 ========================
string tool_id  # 目标工具 ID，如 "gripper0"（两指夹爪）、"gripper2"（三指夹爪）、
                # "suction"（吸盘），定义在 tools.yaml 中的 tool_id 字段喵~

---
# ======================== 响应字段 ========================
bool success      # 切换是否成功：true=工具已成功安装，false=切换失败（夹爪未对准/通信异常等）喵~
int32 error_code  # 错误代码：0=成功，非零=具体错误类型喵~
string message    # 切换结果详细信息，包含执行过程和最终结果描述喵~

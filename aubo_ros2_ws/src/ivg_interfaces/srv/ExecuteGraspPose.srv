# =============================================================================
# ExecuteGraspPose.srv — 执行单次抓取放置任务服务
# 用途：对指定工件执行完整的抓取-放置动作序列（视觉估计 → 接近 → 抓取 → 抬升 → 移动 → 放置）喵~
# 调用方：上位机任务调度节点（如 IVG 主控节点）
# 服务方：demo_interface 的 ExecuteGraspPoseWorker 节点
# 说明：这是视觉引导抓取的核心服务接口，内部包含接近、抓取闭合、抬升、移动至放置位、放置、
#       退回等完整的动作序列喵~
#       use_visual_estimation=true 时使用实时视觉估计结果进行抓取位姿计算；
#       false 时使用参数中预设的常量位姿喵~
#       关于夹爪 IO 语义：ExecuteGraspPoseWorker 的 true=打开（与 PublishGraspsClientWorker 语义相反），
#       这是由不同工位电气接线差异导致的喵~ 详见 CLAUDE.md 第 6 条喵~
# =============================================================================

# ======================== 请求字段 ========================
string object_id               # 目标工件 ID，用于标识要抓取的工件类型和对应的抓取参数喵~
bool use_visual_estimation     # 是否使用视觉估计：true=使用实时 GraspNet 视觉估计结果确定抓取位姿，
                               # false=使用服务端预先配置的参数常量位姿喵~

---
# ======================== 响应字段 ========================
bool success                    # 抓取任务是否成功完成：true=完整抓取-放置序列执行成功喵~
string message                  # 状态消息或错误信息，失败时包含具体阶段和原因喵~
geometry_msgs/Point final_position       # 最终使用的抓取位置（三维坐标），单位：米（m）喵~
geometry_msgs/Quaternion final_orientation  # 最终使用的抓取姿态（四元数），用于记录和日志喵~

# =============================================================================
# GetFK.srv — 正运动学求解服务
# 用途：根据6个关节角度计算机器人TCP在笛卡尔空间中的位姿（位置+姿态）喵~
# 调用方：MoveGroupInterface 规划模块、状态监控节点
# 服务方：aubo_driver_ros2 的 robot_move_group_interface 节点
# =============================================================================

# 请求 —— 输入6个关节角度（弧度）
float32[6] joint      # 6个关节的角度值，单位：弧度（rad），取值范围：各关节限位由URDF定义喵~

---
# 响应 —— 输出TCP在笛卡尔空间中的位姿
float32[3] pos        # TCP位置坐标 (x, y, z)，单位：米（m），相对于机器人基坐标系喵~
float32[4] ori        # TCP姿态四元数 (w, x, y, z)，归一化四元数，w为实部
                      # 此顺序直接透传 AUBO SDK Ori 结构体 ({w,x,y,z})，与 ROS
                      # geometry_msgs/Quaternion 数组表示 (x,y,z,w) 不同喵~

# =============================================================================
# LatteCartesianPlan.srv — 拉花笛卡尔路径规划+执行服务喵~
# 用途: latte_cartesian_planner C++ 节点提供, Python pipeline 调用
# 封装 MoveGroupInterface::computeCartesianPath() + execute() 为单一服务
# 区别于 /compute_cartesian_path (GetCartesianPath) — 直接走 MoveGroupInterface
# =============================================================================

# ======================== 请求字段 ========================
geometry_msgs/Pose[] waypoints       # EE 笛卡尔 waypoints 喵~
float64 max_step 0.01                # 笛卡尔插值步长 (m) 喵~
float64 jump_threshold 0.0           # 跳变检测阈值, 0.0=禁用 喵~
bool avoid_collisions true           # 启用碰撞检测 喵~
float64 velocity_scaling 0.5         # 速度缩放因子 (0, 1] 喵~
float64 acceleration_scaling 0.5     # 加速度缩放因子 (0, 1] 喵~
float64 fraction_threshold 0.95      # 最小可执行 fraction 阈值 喵~
float64 dt 0.0                       # 轨迹时间步长 (s), 0.0=使用 MoveIt 默认时间 喵~

---
# ======================== 响应字段 ========================
bool success                         # plan+execute 均成功时 true 喵~
string message                       # 状态消息或错误描述 喵~
float64 fraction                     # 笛卡尔路径 fraction [0, 1] 喵~
int32 trajectory_points              # 生成的关节轨迹点数量 喵~
int32 error_code_val                 # MoveItErrorCode.val (0=SUCCESS) 喵~

# =============================================================================
# ListTemplates.srv — 模板列表查询服务
# 用途：查询当前模板库中注册的所有模板 ID 及其对应的工件 ID 列表喵~
# 调用方：Web Dashboard 模板管理界面、调试节点
# 服务方：visual_pose_estimation 的 pose_estimation_server 节点
# 说明：可选参数 workpiece_id 用于筛选特定工件的所有模板喵~
#       通过此服务可以获取当前可用的模板列表，用于 EstimatePose 和 EstimatePose2D 的 object_id 参数喵~
#       模板通过 StandardizeTemplate 服务注册到模板库中喵~
# =============================================================================

# ======================== 请求字段 ========================
string workpiece_id  # 工件 ID（可选），用于筛选返回特定工件的模板列表；
                     # 如果为空字符串或未设置，则返回所有工件的所有模板喵~

---
# ======================== 响应字段 ========================
bool success          # 是否成功获取到模板列表喵~
string error_message  # 错误消息（如果失败），包含失败原因描述喵~
string[] template_ids  # 模板 ID 列表，每个模板唯一标识一个注册的模板喵~
                       # 格式如 ["coffee_cup_top", "milk_box_front", ...]喵~
string[] workpiece_ids # 工件 ID 列表，与 template_ids 一一对应，
                       # 标识每个模板所属的工件类型喵~

# =============================================================================
# MoveJoint.srv — 关节空间运动服务（MoveJ）
# 用途：控制机器人各关节独立运动到目标角度，路径不保证 TCP 在笛卡尔空间为直线喵~
# 调用方：示教控制节点、位姿校准节点、故障恢复节点
# 服务方：demo_interface 的 robot_move_group_interface 节点（SDK moveJoint 封装）
# 说明：MoveJ（关节空间运动）模式下各关节同时以最大允许速度运动至目标角度，
#       路径是关节空间中的最短路径，TCP 在笛卡尔空间中通常不是直线喵~
#       适用于无障碍空间中的快速点对点运动，适合大范围移动场景喵~
# =============================================================================

# ======================== 请求字段 ========================
float64[6] joints  # 目标6个关节角度，单位：弧度（rad），顺序：joint_1 ~ joint_6，
                   # 必须在各关节的限位范围内（定义于 URDF / joint_limits.yaml）喵~
float64 velocity   # 速度倍率，范围：(0.0, 1.0]，1.0=全速，0.5=50%速度，作用于 SDK 关节速度喵~

---
# ======================== 响应字段 ========================
bool success          # 运动指令是否发送成功：true=指令下发至控制器成功，false=指令下发失败喵~
int32 error_code      # 错误码：0=成功，非零=具体错误类型（如：关节角超限、机器人未使能等）喵~
string message        # 状态消息或错误信息喵~

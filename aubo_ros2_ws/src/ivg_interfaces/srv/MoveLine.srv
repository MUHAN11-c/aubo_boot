# =============================================================================
# MoveLine.srv — 笛卡尔直线运动服务（MoveL）
# 用途：控制 TCP 沿空间直线从当前点运动到目标点，姿态线性插值喵~
# 调用方：视觉抓取节点、放置对位节点、轨迹示教节点
# 服务方：demo_interface 的 robot_move_group_interface 节点（SDK moveLine 封装）
# 说明：MoveL（直线运动）模式下 TCP 在笛卡尔空间中沿直线轨迹运动，
#       姿态在起点和终点之间做线性四元数插值 SLERP喵~
#       注意：输入为目标关节角度，SDK 内部通过逆运动学（IK）求解笛卡尔路径喵~
#       奇异点附近 IK 可能存在多个解或不稳定的解，导致运动失败喵~
#       在需要保持 TCP 直线路径的场景（如沿工件边缘移动）必须使用此服务喵~
# =============================================================================

# ======================== 请求字段 ========================
float64[6] joints  # 目标6个关节角度，单位：弧度（rad），
                   # SDK 内部根据此关节角反算对应的笛卡尔位姿作为直线运动终点喵~
float64 velocity   # 速度倍率，范围：(0.0, 1.0]，1.0=全速，0.5=50%速度，作用于 SDK 直线运动速度喵~

---
# ======================== 响应字段 ========================
bool success          # 运动指令是否发送成功：true=指令下发至控制器成功，false=指令下发失败喵~
int32 error_code      # 错误码：0=成功，非零=具体错误类型（如：奇异点不可达、IK 求解失败等）喵~
string message        # 状态消息或错误信息喵~

# =============================================================================
# MoveToPose.srv — 运动到目标位姿服务（高级封装）
# 用途：控制机器人运动到指定的目标位姿，支持关节空间（MoveJ）和笛卡尔空间（MoveL）两种模式喵~
# 调用方：视觉抓取节点、工件放置节点、示教控制节点
# 服务方：demo_interface 的 robot_move_group_interface 节点
# 说明：use_joints=true 时使用 target_joints 进行关节空间运动（MoveJ），
#       use_joints=false 时使用 target_pose 进行笛卡尔空间运动（MoveL）喵~
#       velocity_factor 和 acceleration_factor 是 MoveIt 的重缩放因子，作用于 joint_limits.yaml 定义的最大值喵~
# =============================================================================

# ======================== 请求字段 ========================
geometry_msgs/Pose target_pose    # 目标TCP位姿（位置+四元数姿态），仅在 use_joints=false 时使用喵~
                                  # 位置单位：米（m），姿态为归一化四元数喵~
float64[6] target_joints          # 目标6个关节角度，单位：弧度（rad），仅在 use_joints=true 时使用喵~
                                  # 顺序：joint_1 ~ joint_6，需在关节限位范围内喵~
bool use_joints                   # 运动模式：true=关节空间运动（MoveJ，路径不保证TCP直线），
                                  #           false=笛卡尔空间运动（MoveL，TCP沿直线轨迹插补）喵~
float32 velocity_factor           # 速度倍率，范围：(0, 1.0]，作用于 joint_limits.yaml 中 max_velocity 的缩放因子喵~
                                  # 0 回退到 joint_limits.yaml 默认值，>1 截断为 1.0喵~
float32 acceleration_factor       # 加速度倍率，范围：(0, 1.0]，作用于 joint_limits.yaml 中 max_acceleration 的缩放因子喵~
                                  # 0 回退到 joint_limits.yaml 默认值，>1 截断为 1.0喵~

---
# ======================== 响应字段 ========================
bool success      # 运动是否成功：true=成功到达目标位姿，false=运动失败或规划失败喵~
int32 error_code  # 错误码：0=成功，非零=具体错误类型（未完成完整定义，详见日志）喵~
string message    # 状态消息或错误信息，包含失败原因的描述文本喵~

# =============================================================================
# Movel.srv — 单轴直线运动服务 (已废弃 — @deprecated)
#
# 替代方案: 直接使用 MoveGroupInterface::computeCartesianPath()（MoveIt2 标准 API）。
# latte_imitation 等模块已全部迁移至 MoveIt2 标准管线。
# 此服务的 C++ 实现 (MovelServer) 无 .cpp 文件，保留接口定义仅用于向前兼容。
#
# 用途：在笛卡尔空间中沿指定坐标轴方向进行直线运动（仅移动 x/y/z 中的单一轴向）喵~
# 调用方：示教控制节点、手动微调节点、对位调整节点
# 服务方：demo_interface 的 robot_move_group_interface 节点
# 说明：MoveL（直线运动）的特化版本，调用此服务时 target_pose 作为位移基线，
#       实际仅 move_axis 指定的轴向生效（通过 MoveIt computeCartesianPath 实现）喵~
#       每次调用只移动一个轴，连续多轴移动需要多次调用喵~
# =============================================================================

# ======================== 请求字段 ========================
geometry_msgs/Pose target_pose    # 目标位姿基线，在 move_axis 指定的轴向上提取偏移量喵~
                                  # 位置单位：米（m），姿态为归一化四元数喵~
float32 velocity_factor           # 速度倍率，范围：(0.0, 1.0]，作用于 MoveIt 速度缩放喵~
float32 acceleration_factor       # 加速度倍率，范围：(0.0, 1.0]，作用于 MoveIt 加速度缩放喵~
string move_axis                  # 运动轴向，仅支持以下三种取值：
                                  # "x" = 沿机器人基座标系 X 轴方向直线移动，
                                  # "y" = 沿机器人基座标系 Y 轴方向直线移动，
                                  # "z" = 沿机器人基座标系 Z 轴方向直线移动，
                                  # 每次调用只能指定一个轴向喵~

---
# ======================== 响应字段 ========================
bool success      # 运动是否成功：true=到达目标 TCP 位置，false=运动失败或规划失败喵~
int32 error_code  # 错误码：0=成功，非零=具体错误类型喵~
string message    # 状态消息或错误信息喵~

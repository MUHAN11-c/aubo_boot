# =============================================================================
# ReadRobotIO.srv — 读取机器人 IO 状态服务
# 用途：读取控制柜端或工具端指定 IO 引脚的当前输入/输出状态喵~
# 调用方：夹爪控制节点、传感器读取节点、Web Dashboard 节点
# 服务方：demo_interface 的 robot_move_group_interface 节点（SDK getIO 封装）
# 说明：可读取数字量输入（检测通断信号，如限位开关、按钮等）和模拟量输入（检测电压/电流传感器值）喵~
#       引脚号参见 SetRobotIO.srv 的 io_index 说明喵~
# =============================================================================

# ======================== 请求字段 ========================
string io_type    # IO 类型："digital"=读取数字量状态（返回 0 或 1），
                  # "analog"=读取模拟量值（返回电压或电流值）喵~
int32 io_index    # IO 通道索引，从 0 开始，同 SetRobotIO.srv 的 io_index 说明喵~

---
# ======================== 响应字段 ========================
bool success      # 读取是否成功：true=成功读取，false=读取失败（索引越界或通信异常）喵~
float64 value     # 读取到的值：数字量模式下返回 0（OFF）或 1（ON）；
                  # 模拟量模式返回浮点值（电压单位 V，电流单位 mA）喵~
string message    # 状态消息或错误信息喵~

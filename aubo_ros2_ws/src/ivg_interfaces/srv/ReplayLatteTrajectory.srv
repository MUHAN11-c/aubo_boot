# =============================================================================
# ReplayLatteTrajectory.srv — 调用 Latte 拉花轨迹回放服务喵~
# 用途: 录制回放 (npz) 或参数化生成 (heart/rosetta/tulip/swan), 通过 MoveIt2 管线执行
# 调用方: 上位机任务调度节点、示教控制节点、Web Dashboard
# 服务方: latte_imitation 的 LatteImitationNode
#
# 轨迹源 (二选一, 向后兼容):
#   pattern_type="" → 录制回放 (从 npz 加载, 现有逻辑)
#   pattern_type!="" → 参数化生成 (latte_art 共享库)
#
# 模式说明 (mode 字段):
#   "preview": Phase ①-③ (Load/Generate + Retarget + Publish RViz2 markers), 立即返回喵~
#   "debug":   Phase ①-② (Load/Generate + Retarget), 发布 ~/ee_pose/Path, 立即返回喵~
#   "action":  完整 6 阶段管线: Load/Generate → Retarget → Preview → Safety → Plan → Execute 喵~
#
# 起点语义 (start_pose 字段):
#   position=(0,0,0) 且 orientation=(0,0,0,1) → 自动从 TF 获取当前 EE 位姿 (仅 ROS2 节点)
#   start_pose=非零 → 手动指定轨迹起点 (BFF 和 ROS2 均使用前端传入的值) 喵~
#
# 3 轴 RPY 可调 (roll_deg/pitch_deg/yaw_deg):
#   理论依据: Isaac Teleop Se3RelRetargeter target_offset_roll/pitch/yaw
#   语义: 对整条轨迹的额外全局旋转 (内旋 ZYX = 外旋 XYZ) 喵~
#
# 杯子参数 (cup_*):
#   仅参数化生成时使用, 录制回放时忽略喵~
#
# 倾倒参数 (pour_*):
#   仅参数化生成时使用, 录制回放时忽略喵~
#
# 废弃字段 (保留兼容, 不再生效):
#   pos_only       — no-op, MoveIt2 始终全 6-DOF IK 喵~
#   collision_check — no-op, MoveIt2 内置 avoid_collisions 喵~
# =============================================================================

# ======================== 轨迹源 (二选一) ========================
int32 episode_idx 0          # 模式A: 录制回放 (仅 pattern_type="" 时生效) 喵~
string pattern_type ""       # 模式B: "heart"|"rosetta"|"tulip"|"swan"|"custom"|"" 喵~
string pattern_image_path "" # custom 模式图片路径 (服务器端路径) 喵~
int32 tulip_layers 3         # 郁金香层数, 默认 3 喵~

# ======================== 杯子参数 ========================
float32 cup_center_x 0.0     # 杯口中心 X (m, base_link 坐标系) 喵~
float32 cup_center_y 0.0     # 杯口中心 Y (m) 喵~
float32 cup_surface_z 0.15   # 液面高度 Z (m) 喵~
float32 cup_radius 0.04      # 杯口半径 (m), 默认 4cm 喵~

# ======================== 倾倒参数 ========================
float32 pour_mix_height_offset 0.076     # 融合高度偏移 (m), 默认 7.6cm 喵~
float32 pour_draw_height_offset 0.006    # 成形高度偏移 (m), 默认 0.6cm 喵~
float32 pour_finish_height_offset 0.076  # 收尾高度偏移 (m), 默认 7.6cm 喵~
float32 pour_wiggle_amplitude 0.006      # 摆动振幅 (m), 默认 6mm 喵~
float32 pour_wiggle_frequency 5.0        # 摆动频率 (Hz), 默认 5Hz 喵~
float32 pour_max_velocity 0.05           # 最大速度 (m/s), 默认 5cm/s 喵~
float32 pour_max_acceleration 0.1        # 最大加速度 (m/s²) 喵~
float32 pour_max_jerk 0.5                # 最大加加速度 (m/s³) 喵~
bool enable_anti_sloshing true           # 启用抗晃荡速度剖面 喵~

# ======================== 通用参数 ========================
string arm "right"           # 机械臂标识: "left"=持杯臂, "right"=拉花臂 喵~
float32 speed_scale 1.0      # 播放速度倍率 [0.01, 10.0] 喵~
string mode "preview"        # "preview"|"debug"|"action" 喵~

float32 roll_deg 0.0         # 绕 X 轴旋转角度 (度), Isaac Teleop 语义 喵~
float32 pitch_deg 0.0        # 绕 Y 轴旋转角度 (度) 喵~
float32 yaw_deg 0.0          # 绕 Z 轴旋转角度 (度) 喵~

string tool_offset_id "default"  # config/tool_offset.yaml 中的工具 ID 喵~

geometry_msgs/Pose start_pose   # 轨迹起点位姿 (前端传入或 TF 自动获取) 喵~
                                # position=(0,0,0) 且 orientation=(0,0,0,1) → TF 查询 喵~

bool pos_only false          # [废弃] 不再生效 喵~
bool collision_check false   # [废弃] 不再生效 喵~

---
# ======================== 响应字段 ========================
bool success                 # 服务调用是否成功喵~
string message               # 状态消息或错误描述喵~
int32 num_frames             # 轨迹总帧数喵~
float32 path_length          # 笛卡尔路径总长度 (米)喵~
int32 ik_success_count       # 规划成功等效帧数 (debug/preview 模式为 0) 喵~
int32 collision_count        # 始终为 0 (MoveIt2 内部处理碰撞) 喵~
string[] collision_details   # 始终为空 喵~

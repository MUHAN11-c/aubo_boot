# =============================================================================
# RunGripperSwap.srv — 执行快换操作服务
# 用途：执行完整的工具快换流程，将当前夹爪更换为指定的目标夹爪喵~
# 调用方：上位机任务调度节点、工具切换协调节点
# 服务方：tool_changer_interface 的 gripper_swap_worker 节点
# 说明：direction 参数指定快换路径，支持三种快换模式喵~
#       快换流程包含：移动到工具换装站 → 松开当前夹爪 → 对接目标夹爪 → 闭合锁定喵~
#       流程中会自动更新 PlanningScene 碰撞模型和 URDF 以反映当前工具状态喵~
#       快换前必须确认工具换装站上有目标工具可用，且当前夹爪已处于打开状态喵~
#       关于夹爪 IO 语义：方向字符串中的 gripper0/gripper2 对应于 tools.yaml 中定义的工具 ID喵~
# =============================================================================

# ======================== 请求字段 ========================
string direction  # 快换方向/路径：
                  # "gripper0_to_gripper2" = 从 gripper0 切换到 gripper2（双夹爪互换）喵~
                  # "gripper2_to_gripper0" = 从 gripper2 切换到 gripper0（双夹爪互换）喵~
                  # "gripper2" = 单独切换到 gripper2（gripper0保持，适用于首次装载）喵~

---
# ======================== 响应字段 ========================
bool success   # 操作是否成功：true=快换流程成功完成，false=快换失败（需检查日志获取详细原因）喵~
string message # 状态消息或错误信息，包含执行步骤的详细描述喵~

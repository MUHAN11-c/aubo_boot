# =============================================================================
# SetCameraParameters.srv — 设置相机参数服务
# 用途：配置 Percipio 3D 相机的曝光时间、增益、分辨率和触发模式等参数喵~
# 调用方：视觉估计节点、相机初始化节点、Web Dashboard 相机设置
# 服务方：percipio_camera_interface 的相机驱动节点
# 说明：参数设置后立即生效，但不会在相机断电后持久化喵~
#       不同的工作场景（强光/暗光/高速）需要不同的参数组合喵~
#       曝光时间和增益的取值由相机硬件能力决定，过大的值可能导致过曝或图像噪声喵~
#       分辨率越高则每帧处理时间越长，在实时抓取场景中需权衡帧率和精度喵~
# =============================================================================

# ======================== 请求字段 ========================
string camera_id          # 相机 ID，用于标识多相机系统中的目标相机，如 "camera_1", "camera_2"喵~
float32 exposure_time     # 曝光时间，单位：微秒（us），通常范围：100~50000，
                          # 越大的值在暗光下效果越好但运动模糊越严重喵~
float32 gain              # 增益值，单位：dB（分贝），通常范围：0~48，
                          # 越大则在暗光下图像越亮但噪声越大喵~
uint32 resolution_width   # 图像宽度分辨率，单位：像素（px），如 640、1280、1920 等喵~
uint32 resolution_height  # 图像高度分辨率，单位：像素（px），必须与 width 构成有效分辨率对喵~
int8 trigger_mode         # 触发模式：0=连续采集（free-run），1=软件触发（需 SoftwareTrigger 触发），
                          # 2=硬触发（硬件外部信号触发），详见 Percipio SDK 文档喵~

---
# ======================== 响应字段 ========================
bool success   # 设置是否成功：true=参数设置成功，false=设置失败（检查日志获取详细信息）喵~
string message # 状态消息或错误信息，包含失败原因描述喵~

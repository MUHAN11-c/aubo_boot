# =============================================================================
# SetRobotEnable.srv — 设置机器人使能状态服务
# 用途：控制机器人驱动器的上电（使能）或下电（去使能）状态喵~
# 调用方：Web Dashboard 节点、安全保护节点、启动/停止控制节点
# 服务方：demo_interface 的 robot_move_group_interface 节点（SDK robotServiceRobotPowerOn/PowerOff 封装）
# 说明：使能（enable=true）时机器人伺服驱动器通电，可执行运动指令；
#       去使能（enable=false）时伺服驱动器断电，机器人处于自由抱闸状态喵~
#       在启动流程中，必须先成功使能才能执行任何运动指令喵~
#       去使能后必须在安全条件下重新使能方可继续操作喵~
# =============================================================================

# ======================== 请求字段 ========================
bool enable  # true=使能/上电（伺服驱动器通电，机器人可运动）；
             # false=去使能/下电（伺服驱动器断电，机器人抱闸/自由状态）喵~

---
# ======================== 响应字段 ========================
bool success      # 设置是否成功：true=使能状态切换成功，false=切换失败喵~
int32 error_code  # 错误码：0=成功，非零=具体错误类型（如：未满足安全条件、SDK 通信超时等）喵~
string message    # 状态消息或错误信息喵~

# =============================================================================
# SetRobotIO.srv — 设置机器人 IO 输出服务
# 用途：设置控制柜端或工具端 IO 引脚的输出状态（数字量通断或模拟量电压/电流）喵~
# 调用方：夹爪控制节点、气动控制节点、Web Dashboard 节点
# 服务方：demo_interface 的 robot_move_group_interface 节点（SDK setIO 封装）
# 说明：此服务与 aubo_msgs/SetIO.srv 功能类似，但提供了更灵活的字符串类型参数喵~
#       io_type 区分操作的数字量和模拟量模式；io_index 指定通道号喵~
#       引脚号与物理端口的对应关系见 aubo_ros2_driver/README.md 第3节喵~
# =============================================================================

# ======================== 请求字段 ========================
string io_type    # IO 类型："digital"=数字量输出（ON/OFF），"analog"=模拟量输出（电压/电流值）喵~
int32 io_index    # IO 通道索引，从 0 开始：
                  # 控制柜端数字输出: 0~7, 工具端数字输出: 16~17,
                  # 控制柜端模拟输出: 0~1, 可配置输出: 8~15喵~
float64 value     # 输出值：数字量模式下 0=OFF 或 1=ON；
                  # 模拟量模式下为电压值（0~10V，单位 V）或电流值（0~20mA，单位 mA）喵~

---
# ======================== 响应字段 ========================
bool success      # 设置是否成功：true=IO 输出设置成功，false=设置失败喵~
int32 error_code  # 错误码：0=成功，非零=具体错误类型（如：索引越界、类型不匹配等）喵~
string message    # 状态消息或错误信息喵~

# =============================================================================
# SetRobotPose.srv — 设置机器人目标位姿服务（直接关节控制）
# 用途：直接设置机器人关节角度或 TCP 位姿（低层级，通过 SDK 直接下发，不经过 MoveIt 规划）喵~
# 调用方：示教控制节点、手动微调节点、校准节点
# 服务方：demo_interface 的 robot_move_group_interface 节点
# 说明：此服务为底层控制接口，不经过 MoveIt 运动学/碰撞验证，使用前请确保目标位姿安全可达喵~
#       is_radian 仅在 use_joints=true 时有效，指定输入角度的单位是弧度还是度喵~
# =============================================================================

# ======================== 请求字段 ========================
float64[6] target_pose  # 目标值：当 use_joints=true 时为6个关节角度；
                         # 当 use_joints=false 时为 TCP 位姿 [x, y, z, rx, ry, rz]（欧拉角表示）喵~
                         # 位置单位：米（m），角度单位由 is_radian 决定喵~
bool use_joints          # true=使用关节角度控制 / false=使用笛卡尔位姿控制喵~
bool is_radian           # 角度单位标识：仅在 use_joints=true 时有效，
                         # true=输入为弧度（rad），false=输入为度（deg）喵~
float32 velocity         # 运动速度倍率，范围：(0.0, 1.0]，作用于 SDK 内置速度缩放喵~
                         # 注意：此速度不经过 MoveIt，直接通过 SDK 下发至控制器喵~

---
# ======================== 响应字段 ========================
bool success      # 设置是否成功：true=指令发送成功（不保证执行成功），false=指令发送失败喵~
int32 error_code  # 错误码：0=成功，非零=具体错误类型喵~
string message    # 状态消息或错误信息喵~

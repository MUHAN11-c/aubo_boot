# =============================================================================
# SetToolKinematics.srv — 设置工具中心点 (TCP) 参数服务
# 用途：配置工具相对法兰盘中心的位置偏移和姿态偏移，用于 SDK 运动学正逆解计算喵~
# 调用方：工具切换节点（gripper_swap_worker）、TCP 校准节点
# 服务方：demo_interface 的 robot_move_group_interface 节点（SDK setToolKinematics 封装）
# 说明：正确的 TCP 参数对于笛卡尔运动的精度至关重要喵~
#       位置偏移描述工具末端在法兰盘坐标系下的 x/y/z 偏移量喵~
#       姿态偏移描述工具相对法兰盘坐标系的固定旋转（四元数），通常为无旋转 [1, 0, 0, 0]喵~
#       更换工具后必须重新设置此参数，否则笛卡尔运动会存在系统性位姿偏差喵~
#       TCP 参数的精度直接影响抓取和放置的定位精度喵~
# =============================================================================

# ======================== 请求字段 ========================
float64[3] position     # TCP 相对法兰盘中心的位置偏移 (x, y, z)，单位：米（m）喵~
                        # 坐标系：法兰盘中心，Z 轴沿法兰端面法线向外喵~
float64[4] orientation  # TCP 相对法兰盘的姿态偏移四元数 (w, x, y, z)，归一化四元数喵~
                        # 默认值：[1, 0, 0, 0]（无旋转，与法兰盘同姿态）喵~

---
# ======================== 响应字段 ========================
bool success   # 设置是否成功：true=TCP 参数设置成功，false=设置失败喵~
string message # 状态消息或错误信息喵~

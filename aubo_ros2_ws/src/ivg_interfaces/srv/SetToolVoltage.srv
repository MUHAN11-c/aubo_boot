# =============================================================================
# SetToolVoltage.srv — 设置工具端电源电压类型服务
# 用途：设置机器人工具端（法兰盘接口）的输出电压，为末端执行器（夹爪/相机/传感器）供电喵~
# 调用方：工具切换节点（gripper_swap_worker）、Web Dashboard 节点
# 服务方：demo_interface 的 robot_move_group_interface 节点（SDK setToolVoltage 封装）
# 说明：不同工具需要不同的供电电压，切换工具后应根据工具规格重新设置电压喵~
#       注意：电压设置错误可能导致工具损坏喵~
#       常见工具电压：大多数夹爪使用 12V 或 24V，部分视觉传感器使用 12V喵~
# =============================================================================

# ======================== 请求字段 ========================
int32 voltage_type  # 工具端电压类型：
                    # 0 = 0V（关闭工具电源输出），
                    # 1 = 12V（适用小型夹爪/传感器），
                    # 2 = 24V（适用气动阀组/大功率工具）喵~

---
# ======================== 响应字段 ========================
bool success   # 设置是否成功：true=电压设置成功，false=设置失败（可能原因：无效的电压类型值）喵~
string message # 状态消息或错误信息喵~

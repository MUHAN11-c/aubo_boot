# =============================================================================
# SoftwareTrigger.srv — 软件触发相机采集服务
# 用途：通过软件信号触发 Percipio 3D 相机采集一帧图像（深度图 + 彩色图）喵~
# 调用方：视觉估计节点、抓取任务调度节点
# 服务方：percipio_camera_interface 的相机驱动节点
# 说明：仅在相机触发模式设置为 software_trigger（trigger_mode=0）时有效喵~
#       在连续采集模式（trigger_mode=-1）下调用此服务不会有影响喵~
#       每个软件触发请求导致相机采集并发布一帧图像到对应的话题上喵~
#       触发间隔必须大于相机的最短采集周期（通常 > 33ms，取决于曝光时间和分辨率）喵~
# =============================================================================

# ======================== 请求字段 ========================
string camera_id  # 相机 ID，指定要触发的目标相机，如 "camera_1", "camera_2"喵~

---
# ======================== 响应字段 ========================
bool success   # 触发是否成功：true=触发信号已发送至相机，false=发送失败（相机未就绪或模式不匹配）喵~
string message # 状态消息或错误信息喵~

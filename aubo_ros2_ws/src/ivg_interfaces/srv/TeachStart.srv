# =============================================================================
# TeachStart.srv — 示教模式控制服务
# 用途：启动机器人的示教（点动/寸动）模式，使机器人持续朝指定方向运动直到调用 TeachStop喵~
# 调用方：示教控制节点、Web Dashboard 示教面板
# 服务方：demo_interface 的 robot_move_group_interface 节点（SDK teachStart 封装）
# 说明：示教启动后机器人将持续沿指定方向运动，直到控制节点显式调用 TeachStop 停止喵~
#       joint 参数支持单关节示教（1~6）和笛卡尔方向示教（7~12），具体映射见下方注释喵~
#       使用前必须确保安全条件（示教棒按下、速度倍率适当）喵~
#       建议在示教模式下始终将速度倍率设置在 30% 以下以确保操作安全喵~
# =============================================================================

# ======================== 请求字段 ========================
int32 joint  # 示教轴/方向标识：
             # 1~6 = 单关节示教（joint_1~joint_6，依次绕各关节轴旋转）喵~
             # 7 = 沿基坐标系 X 轴平移（正向 direction=true 为 +X）喵~
             # 8 = 沿基坐标系 Y 轴平移喵~
             # 9 = 沿基坐标系 Z 轴平移喵~
             # 10 = 绕基坐标系 X 轴旋转（RX）喵~
             # 11 = 绕基坐标系 Y 轴旋转（RY）喵~
             # 12 = 绕基坐标系 Z 轴旋转（RZ）喵~
bool direction  # 运动方向：true=正方向（关节角度增大 / 坐标轴正向），
                # false=反方向（关节角度减小 / 坐标轴负向）喵~

---
# ======================== 响应字段 ========================
bool success      # 示教启动是否成功：true=成功进入示教模式，false=启动失败喵~
int32 error_code  # 错误码：0=成功，非零=具体错误类型喵~
string message    # 状态消息或错误信息喵~

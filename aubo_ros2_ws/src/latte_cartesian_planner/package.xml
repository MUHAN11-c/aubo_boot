<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>latte_cartesian_planner</name>
  <version>0.1.0</version>
  <description>Cartesian planning + execution for latte art — wraps MoveGroupInterface::computeCartesianPath() + execute() into a single ROS 2 service /latte/plan_and_execute</description>
  <maintainer email="user@example.com">User</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_msgs</depend>
  <depend>ivg_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>moveit_visual_tools</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

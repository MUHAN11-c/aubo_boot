# 2D姿态估计服务请求
# 输入RGB图像，返回2D检测结果（中心坐标、旋转角度、置信度）

# 输入的待处理RGB图像
sensor_msgs/Image image

# 目标物体模板ID
string object_id

---
# 2D姿态估计服务响应

# 识别成功数量
int32 success_num

# 目标中心X坐标（像素）
float32[] center_x

# 目标中心Y坐标（像素）
float32[] center_y

# 旋转角度（度）
float32[] rotation_angle

# 识别置信度（0-1.0）
float32[] confidence

# 可视化结果图像
sensor_msgs/Image vis_image

# 识别状态信息
string message

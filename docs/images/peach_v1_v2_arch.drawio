        <mxCell id="v1e4" value="grasp_decision 令牌（缓存）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4B5A6B;strokeWidth=1.5;fontSize=10;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v1r1" target="v1s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="807" y="95"/><mxPoint x="1165" y="95"/></Array></mxGeometry></mxCell>
        <mxCell id="v1e5" value="SurveyScene / ExecuteTarget / MoveTo · enables" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4B5A6B;strokeWidth=1.5;fontSize=10;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v1s1" target="v1a1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1165" y="95"/><mxPoint x="1490" y="95"/></Array></mxGeometry></mxCell>
        <mxCell id="v1e3" value="target_observations（选果唯一输入）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4B5A6B;strokeWidth=1.5;fontSize=10;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v1p1" target="v1s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="452" y="258"/><mxPoint x="1165" y="258"/></Array></mxGeometry></mxCell>
        <mxCell id="v1e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4B5A6B;strokeWidth=1.5;fontSize=10;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v1r1" target="v1a1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1005" y="245"/><mxPoint x="1490" y="245"/></Array><mxPoint x="-0.35" as="offset"/></mxGeometry></mxCell>

        <mxCell id="v1l7" value="CheckReachability（唯一反向 IK）" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#C00000;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="v1e7"><mxGeometry x="-0.48" relative="1" as="geometry"/></mxCell>

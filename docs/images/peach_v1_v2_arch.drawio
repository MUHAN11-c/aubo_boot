  <diagram id="v2" name="Peach v2 架构">
    <mxGraphModel dx="1860" dy="1060" grid="0" gridSize="10" page="1" pageWidth="1880" pageHeight="1030" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v2title" value="Peach v2 架构（隔离重写 src/peach2/）— 进程 / 组件与数据流" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#172B4D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="v2sub" value="入口 peach2_bringup/peach2_system.launch.py · 五个独立生命周期进程（对照 v1 的一进程三节点）· 盒子=进程/组件，箭头=动作/话题/服务" style="text;html=1;fontSize=11;fontColor=#595959;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="1500" height="20" as="geometry"/></mxCell>

        <mxCell id="v2bandL0" value="L0 传感与只读驱动（厂商边界）" style="rounded=1;html=1;fillColor=#F4F6F9;strokeColor=#C3CBD6;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#1F3864;spacingLeft=12;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="250" height="490" as="geometry"/></mxCell>
        <mxCell id="v2h1" value="&lt;b&gt;RGB-D 相机前端&lt;/b&gt;&lt;br&gt;peach_stereo（默认）&lt;br&gt;/ percipio / replay&lt;br&gt;深度 uint16 × 0.25 mm&lt;br&gt;+ confidence 置信度" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="36" y="155" width="218" height="88" as="geometry"/></mxCell>
        <mxCell id="v2h2" value="&lt;b&gt;TF（按图像 stamp）&lt;/b&gt;&lt;br&gt;失败丢帧，无 latest 回退&lt;br&gt;每条观测带同一 camera_pose" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="36" y="262" width="218" height="88" as="geometry"/></mxCell>
        <mxCell id="v2h3" value="&lt;b&gt;腕六维力（预留）&lt;/b&gt;&lt;br&gt;接触监测首选硬件，未选型&lt;br&gt;缺失按插件回退策略" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="36" y="369" width="218" height="88" as="geometry"/></mxCell>
        <mxCell id="v2h4" value="&lt;b&gt;标定件（单源）&lt;/b&gt;&lt;br&gt;peach2_calibration/results&lt;br&gt;误差常数 · blade_in_tcp&lt;br&gt;（刃面相对 TCP 偏移）" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="36" y="476" width="218" height="95" as="geometry"/></mxCell>

        <mxCell id="v2pC" value="进程 peach2_perception（Lifecycle）" style="rounded=1;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#1F3864;spacingLeft=12;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="320" height="490" as="geometry"/></mxCell>
        <mxCell id="v2p1" value="&lt;b&gt;单帧感知（只出事实，不做裁决）&lt;/b&gt;&lt;br&gt;同步 + 深度质量门（置信度）&lt;br&gt;→ YOLO + MobileSAM" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="285" height="90" as="geometry"/></mxCell>
        <mxCell id="v2p2" value="&lt;b&gt;组件（纯核零 ROS）&lt;/b&gt;&lt;br&gt;LatestSlot 容量 1 + 回调外推理&lt;br&gt;2D/3D 袋底·袋颈·扎口&lt;br&gt;+ 2D↔3D 交叉校验&lt;br&gt;深度噪声模型 → 地标协方差" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="310" y="270" width="285" height="115" as="geometry"/></mxCell>
        <mxCell id="v2p3" value="&lt;b&gt;跟踪与锁定&lt;/b&gt;&lt;br&gt;KF 多目标跟踪（按图像 stamp）&lt;br&gt;摆动估计（短窗正弦 + 漂移）&lt;br&gt;LockPolicy 锁定集 + scene_epoch&lt;br&gt;旧帧拒收；臂运动中置 invalid" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="310" y="415" width="285" height="175" as="geometry"/></mxCell>

        <mxCell id="v2mC" value="进程 peach2_target_model（Lifecycle）" style="rounded=1;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#1F3864;spacingLeft=12;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="635" y="110" width="320" height="490" as="geometry"/></mxCell>
        <mxCell id="v2m1" value="&lt;b&gt;多视融合 + 目标模型&lt;/b&gt;&lt;br&gt;视点内聚合 → 视点间 Huber 融合" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="655" y="150" width="285" height="90" as="geometry"/></mxCell>
        <mxCell id="v2m2" value="&lt;b&gt;组件（纯核零 ROS）&lt;/b&gt;&lt;br&gt;landmarks3d 切片圆拟合&lt;br&gt;fusion · tracker · swing&lt;br&gt;袋轴/袋颈/袋径 d95 + σ95&lt;br&gt;model_revision 递增" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="655" y="270" width="285" height="115" as="geometry"/></mxCell>
        <mxCell id="v2m3" value="&lt;b&gt;许可预算（RSS）&lt;/b&gt;&lt;br&gt;GetDecision 唯一出口（同步查询）&lt;br&gt;approach / sleeve / cut 分档&lt;br&gt;标定状态 + 袋颈复测约束剪切&lt;br&gt;validity_s=120，过期拒执行" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="655" y="415" width="285" height="175" as="geometry"/></mxCell>

        <mxCell id="v2tC" value="进程 peach2_task（Lifecycle · BT.CPP）" style="rounded=1;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#1F3864;spacingLeft=12;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="330" height="490" as="geometry"/></mxCell>
        <mxCell id="v2t1" value="&lt;b&gt;harvest_batch 行为树&lt;/b&gt;&lt;br&gt;ReactiveSequence / CheckSafety&lt;br&gt;观察 → 许可 → 执行 → 重试 / ACK" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="v2t2" value="&lt;b&gt;组件（纯核零 ROS）&lt;/b&gt;&lt;br&gt;batch_session · selection 选果&lt;br&gt;（锁定集/质量/深度/可达）&lt;br&gt;ledger 账本=作业结果权威&lt;br&gt;至多一次终局，不伪造成功" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="270" width="290" height="115" as="geometry"/></mxCell>
        <mxCell id="v2t3" value="&lt;b&gt;使能链与身份&lt;/b&gt;&lt;br&gt;Enables：tool ⇒ grasp ⇒ execution&lt;br&gt;+ 1 Hz 心跳（默认全 false）&lt;br&gt;request_id / target_id / revision&lt;br&gt;FailureCode 分项 1x…6x" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1000" y="415" width="290" height="175" as="geometry"/></mxCell>

        <mxCell id="v2gC" value="进程 peach2_manipulation（Lifecycle · C++）" style="rounded=1;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#1F3864;spacingLeft=12;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1335" y="110" width="295" height="490" as="geometry"/></mxCell>
        <mxCell id="v2g1" value="&lt;b&gt;CommandGate 命令门&lt;/b&gt;&lt;br&gt;轨迹与刀具 SetIO 的单一入口&lt;br&gt;Active ∧ robotReady ∧ enables 链&lt;br&gt;∧ 阶段许可；关门=取消 + stop" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1351" y="150" width="263" height="90" as="geometry"/></mxCell>
        <mxCell id="v2g2" value="&lt;b&gt;HarvestCycle 单目标周期&lt;/b&gt;&lt;br&gt;staging → pregrasp → insert&lt;br&gt;→ cut → confirm → retreat&lt;br&gt;滚转采样 + OMPL + Pilz LIN&lt;br&gt;INSERT/CUT 前复检 GetDecision" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1351" y="270" width="263" height="115" as="geometry"/></mxCell>
        <mxCell id="v2g3" value="&lt;b&gt;场景差分 + 逆路撤退&lt;/b&gt;&lt;br&gt;邻袋胶囊 peach_bag_* 原子 diff&lt;br&gt;（只动本前缀，不改 ACM）&lt;br&gt;reverse_path 倒放 + 碰撞校验" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1351" y="415" width="263" height="95" as="geometry"/></mxCell>
        <mxCell id="v2g4" value="&lt;b&gt;EndEffector pluginlib&lt;/b&gt;&lt;br&gt;ShearV1 / BiteShearV1 / AdaptiveShearV1&lt;br&gt;刃面偏移 · roll · prepare/cut/confirm/release&lt;br&gt;剪切确认独立于剪切命令" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1351" y="520" width="263" height="75" as="geometry"/></mxCell>

        <mxCell id="v2bandD" value="驱动与柜（只读）" style="rounded=1;html=1;fillColor=#F4F6F9;strokeColor=#C3CBD6;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#1F3864;spacingLeft=12;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1650" y="110" width="210" height="490" as="geometry"/></mxCell>
        <mxCell id="v2d1" value="&lt;b&gt;move_group&lt;/b&gt;&lt;br&gt;MoveIt（MTC 候选演进）" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1662" y="155" width="186" height="88" as="geometry"/></mxCell>
        <mxCell id="v2d2" value="&lt;b&gt;ros2_control + JTC&lt;/b&gt;&lt;br&gt;mock=GenericSystem&lt;br&gt;（命令镜像）" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1662" y="262" width="186" height="88" as="geometry"/></mxCell>
        <mxCell id="v2d3" value="&lt;b&gt;AUBO E5 控制柜&lt;/b&gt;&lt;br&gt;TCP2CAN · 工具 DO&lt;br&gt;反馈 DI 分物理通道" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1662" y="369" width="186" height="88" as="geometry"/></mxCell>
        <mxCell id="v2d4" value="&lt;b&gt;示教器 / 急停&lt;/b&gt;&lt;br&gt;硬件回路，不经 ROS&lt;br&gt;故障后禁止 resume" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1662" y="476" width="186" height="88" as="geometry"/></mxCell>

        <mxCell id="v2b1" value="&lt;b&gt;peach2_scene（Lifecycle）&lt;/b&gt;&lt;br&gt;BuildSceneSnapshot：按需取帧&lt;br&gt;→ 硬障碍快照&lt;br&gt;写 PlanningScene（全臂受查）&lt;br&gt;阶段局部豁免、自动回滚&lt;br&gt;不写全局 ACM；目标袋挖空&lt;br&gt;邻袋胶囊由 manipulation 写" style="rounded=1;html=1;fillColor=#E8F0E8;strokeColor=#548235;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="430" height="290" as="geometry"/></mxCell>
        <mxCell id="v2b2" value="&lt;b&gt;peach2_lifecycle_manager&lt;/b&gt;&lt;br&gt;（= nav2_lifecycle_manager）&lt;br&gt;名单：perception → target_model&lt;br&gt;→ scene → manipulation → task&lt;br&gt;bond_timeout 默认 4.0（死检开）&lt;br&gt;启动/配置不动臂、不写 IO" style="rounded=1;html=1;fillColor=#E8F0E8;strokeColor=#548235;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="480" y="640" width="380" height="290" as="geometry"/></mxCell>
        <mxCell id="v2b3" value="&lt;b&gt;peach2_observability（只读）&lt;/b&gt;&lt;br&gt;/diagnostics 聚合 + 会话 bag&lt;br&gt;+ 8091 只读面板&lt;br&gt;不发运动、不写 IO&lt;br&gt;跳过/拒绝可关联 request·目标·&lt;br&gt;工具·版本·阶段" style="rounded=1;html=1;fillColor=#E8E3F5;strokeColor=#7B5EA7;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="890" y="640" width="420" height="290" as="geometry"/></mxCell>
        <mxCell id="v2b4" value="&lt;b&gt;库与契约（能力包不互相 import 业务代码）&lt;/b&gt;&lt;br&gt;peach2_interfaces 精简 IDL&lt;br&gt;peach2_core 纯核零 ROS&lt;br&gt;（tracker / landmarks3d / fusion / budget / swing）&lt;br&gt;peach2_end_effector 插件库&lt;br&gt;peach2_calibration 标定工具&lt;br&gt;peach2_system_tests（launch_testing）" style="rounded=1;html=1;fillColor=#E8E3F5;strokeColor=#7B5EA7;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1340" y="640" width="520" height="290" as="geometry"/></mxCell>

        <mxCell id="v2note" value="与 v1 的结构差异：① 一进程三节点 brain → 五个独立生命周期进程；② FSM/reducer/令牌三轨 → 行为树 + GetDecision 同步许可（无 Clearance 平行令牌）；③ 臂侧双路授权/快照回退 → 命令门单一入口，INSERT/CUT 前复检；④ 障碍只护相机 → 全臂受查 + 阶段局部豁免；⑤ 工具接线 dict → pluginlib 末端插件；⑥ bond_timeout 0 → 4.0。同仓并存、不同 launch，不同时占有同一真机执行器。M1 mock 预抓取已过，台架标定、三末端实机与果园闭环未过。" style="text;html=1;fontSize=11;fontColor=#1F3864;align=left;verticalAlign=top;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="24" y="950" width="1836" height="60" as="geometry"/></mxCell>


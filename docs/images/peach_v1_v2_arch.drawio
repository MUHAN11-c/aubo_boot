<mxfile host="app.diagrams.net" agent="peach_arch" version="24.7.8">
  <diagram id="v1" name="Peach v1 架构">
    <mxGraphModel dx="1860" dy="1060" grid="0" gridSize="10" page="1" pageWidth="1880" pageHeight="1030" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1title" value="Peach v1 架构（现行采摘核）— 进程 / 组件与数据流" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#172B4D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="v1sub" value="入口 peach_bringup/launch/harvest_system.launch.py · 源码 src/peach_* · 盒子=可运行进程/组件，箭头=它运的东西（动作/话题/服务）" style="text;html=1;fontSize=11;fontColor=#595959;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="1500" height="20" as="geometry"/></mxCell>

        <mxCell id="v1bandL0" value="L0 传感与只读驱动（AGENTS 红线）" style="rounded=1;html=1;fillColor=#F4F6F9;strokeColor=#C3CBD6;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#1F3864;spacingLeft=12;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="250" height="490" as="geometry"/></mxCell>
        <mxCell id="v1h1" value="&lt;b&gt;RGB-D 相机&lt;/b&gt;&lt;br&gt;Percipio PS800-E1&lt;br&gt;peach_stereo（默认）&lt;br&gt;/ percipio_camera&lt;br&gt;深度 uint16 毫米" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="36" y="155" width="218" height="88" as="geometry"/></mxCell>
        <mxCell id="v1h2" value="&lt;b&gt;TF（帧契约唯一）&lt;/b&gt;&lt;br&gt;robot_state_publisher 臂链&lt;br&gt;extrinsics_publisher&lt;br&gt;只发 wrist3→camera_link" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="36" y="262" width="218" height="88" as="geometry"/></mxCell>
        <mxCell id="v1h3" value="&lt;b&gt;serial_imu（可选）&lt;/b&gt;&lt;br&gt;/imu/data · /force/points&lt;br&gt;（咬合 5 点力）&lt;br&gt;不进 lifecycle" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="36" y="369" width="218" height="88" as="geometry"/></mxCell>
        <mxCell id="v1h4" value="&lt;b&gt;手眼标定外参&lt;/b&gt;&lt;br&gt;wrist3→camera_link 标定件&lt;br&gt;只读；重建积分用精确 stamp&lt;br&gt;禁 latest TF" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="36" y="476" width="218" height="95" as="geometry"/></mxCell>

        <mxCell id="v1brain" value="进程 peach_harvester.brain — 一进程三节点（图名不变）" style="rounded=1;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#1F3864;spacingLeft=12;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="1040" height="490" as="geometry"/></mxCell>
        <mxCell id="v1p1" value="&lt;b&gt;peach_scene_perception_node&lt;/b&gt;&lt;br&gt;（Lifecycle）· 看一帧&lt;br&gt;检测 YOLO + MobileSAM&lt;br&gt;→ 袋底/袋颈地标 → 身份注册表" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="285" height="90" as="geometry"/></mxCell>
        <mxCell id="v1p2" value="&lt;b&gt;组件（纯核零 ROS）&lt;/b&gt;&lt;br&gt;vision/detector · segmentation&lt;br&gt;bag_landmarks（几何推袋颈）&lt;br&gt;BeginScene 开场景&lt;br&gt;真相流（全量）/ 稳定流（confirmed）" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="310" y="270" width="285" height="115" as="geometry"/></mxCell>
        <mxCell id="v1p3" value="&lt;b&gt;边界&lt;/b&gt;&lt;br&gt;只出观测事实，不发运动&lt;br&gt;不调 MoveIt&lt;br&gt;ACCEPT 只作初值/可视化&lt;br&gt;不作选果输入" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="310" y="415" width="285" height="175" as="geometry"/></mxCell>
        <mxCell id="v1r1" value="&lt;b&gt;peach_target_reconstruction_node&lt;/b&gt;&lt;br&gt;（Lifecycle）· 建一颗&lt;br&gt;多视 TSDF/ICP + 柱/球 refit&lt;br&gt;输出模型七元组 + plan_id" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="665" y="150" width="285" height="90" as="geometry"/></mxCell>
        <mxCell id="v1r2" value="&lt;b&gt;组件（纯核零 ROS）&lt;/b&gt;&lt;br&gt;refine 轴向/径向预算&lt;br&gt;（误差线性合成）· tool_budget&lt;br&gt;refitter dict 映射（UNWIND，不扩）" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="665" y="270" width="285" height="115" as="geometry"/></mxCell>
        <mxCell id="v1r3" value="&lt;b&gt;GraspDecision 令牌&lt;/b&gt;&lt;br&gt;（套入/剪切分档权威）&lt;br&gt;CONTACT=sleeve / 径向余量&lt;br&gt;TOOL=cut / 轴向余量 + 残差&lt;br&gt;allowed 只作汇总展示&lt;br&gt;valid_until 冻结不续签&lt;br&gt;refined_pose 另发臂/场景障碍" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="665" y="415" width="285" height="175" as="geometry"/></mxCell>
        <mxCell id="v1s1" value="&lt;b&gt;peach_supervisor&lt;/b&gt;（Lifecycle）&lt;br&gt;选果（只订 target_observations）&lt;br&gt;harvest_fsm 纯核&lt;br&gt;（9 批次态 / 12 目标相）" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1020" y="150" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="v1s2" value="&lt;b&gt;组件（纯核零 ROS）&lt;/b&gt;&lt;br&gt;批次态只经 react / reducer / _apply&lt;br&gt;账本 runs/&amp;lt;request_id&amp;gt;/ledger.json&lt;br&gt;补采清单 · 暂停 / 单步&lt;br&gt;RunHarvest / ControlTask 服务面" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1020" y="270" width="290" height="115" as="geometry"/></mxCell>
        <mxCell id="v1s3" value="&lt;b&gt;身份（四层）&lt;/b&gt;&lt;br&gt;target_id → request_id/run_id/cycle_id&lt;br&gt;→ plan_id + 模型七元组 → clearance&lt;br&gt;（复用 target_id，不铸新 ID）&lt;br&gt;grasp_decision 仅作接触许可令牌缓存&lt;br&gt;装配 goal.clearance，不是选果输入" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1020" y="415" width="290" height="175" as="geometry"/></mxCell>

        <mxCell id="v1arm" value="进程 peach_arm（Lifecycle）" style="rounded=1;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#1F3864;spacingLeft=12;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1350" y="110" width="280" height="490" as="geometry"/></mxCell>
        <mxCell id="v1a1" value="&lt;b&gt;cycle.cpp + ExecutionAuthority&lt;/b&gt;&lt;br&gt;授权矩阵逐阶段把关&lt;br&gt;套入/剪切前复检 GraspDecision" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1366" y="150" width="248" height="90" as="geometry"/></mxCell>
        <mxCell id="v1a2" value="&lt;b&gt;stages.cpp 阶段执行器&lt;/b&gt;&lt;br&gt;Survey → 预抓取 → 套入 → 剪切&lt;br&gt;→ 原路撤退 → 回 stow&lt;br&gt;干跑默认 PREGRASP_ONLY 停住&lt;br&gt;（不 SetIO）" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1366" y="270" width="248" height="115" as="geometry"/></mxCell>
        <mxCell id="v1a3" value="&lt;b&gt;GraspTask MTC + ToolActuator&lt;/b&gt;&lt;br&gt;接近 v4：PTP → 世界垂直 LIN&lt;br&gt;入冠 → 沿轴 LIN&lt;br&gt;剪切 SetIO + DI 新上升沿确认&lt;br&gt;超时 CUT_UNCONFIRMED 保守收口&lt;br&gt;shear/bite=MTC LIN&lt;br&gt;adaptive=imu_follow 接触窗" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#4472C4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1366" y="415" width="248" height="175" as="geometry"/></mxCell>

        <mxCell id="v1bandD" value="驱动与柜（只读）" style="rounded=1;html=1;fillColor=#F4F6F9;strokeColor=#C3CBD6;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#1F3864;spacingLeft=12;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1650" y="110" width="210" height="490" as="geometry"/></mxCell>
        <mxCell id="v1d1" value="&lt;b&gt;move_group&lt;/b&gt;&lt;br&gt;MoveIt / MTC" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1662" y="155" width="186" height="88" as="geometry"/></mxCell>
        <mxCell id="v1d2" value="&lt;b&gt;ros2_control + JTC&lt;/b&gt;&lt;br&gt;mock=GenericSystem&lt;br&gt;（命令镜像）" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1662" y="262" width="186" height="88" as="geometry"/></mxCell>
        <mxCell id="v1d3" value="&lt;b&gt;AUBO E5 控制柜&lt;/b&gt;&lt;br&gt;TCP2CAN · 工具 DO&lt;br&gt;io_states 反馈 DI" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1662" y="369" width="186" height="88" as="geometry"/></mxCell>
        <mxCell id="v1d4" value="&lt;b&gt;示教器 / 急停&lt;/b&gt;&lt;br&gt;上电、抱闸、硬件急停&lt;br&gt;不经 ROS&lt;br&gt;软件停不得称 e-stop" style="rounded=1;html=1;fillColor=#FFF3E6;strokeColor=#C55A11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1662" y="476" width="186" height="88" as="geometry"/></mxCell>

        <mxCell id="v1b1" value="&lt;b&gt;imu_follow_servo（旁路，仅 adaptive_shear_v1）&lt;/b&gt;&lt;br&gt;接触窗 enable → insert_start → insert_stop&lt;br&gt;→ 剪切 → insert_retract → disable&lt;br&gt;motion.enabled 默认 false（不自动开门）&lt;br&gt;与 MTC 互斥写控制器，不经过 authorizeStage&lt;br&gt;判据=FK 位移投影 + insert_progress&lt;br&gt;（时间只作截止）" style="rounded=1;html=1;fillColor=#E8F0E8;strokeColor=#548235;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="430" height="290" as="geometry"/></mxCell>
        <mxCell id="v1b2" value="&lt;b&gt;peach_scene_obstacles（独立进程）&lt;/b&gt;&lt;br&gt;不进 lifecycle&lt;br&gt;Survey 成功后 obstacles_refresh 取快照&lt;br&gt;用 refined_pose 滤除当前果胶囊&lt;br&gt;只写 PlanningScene&lt;br&gt;world.collision_objects&lt;br&gt;（peach_arm 只写 ACM diff）&lt;br&gt;用途=保护相机，非全臂避障" style="rounded=1;html=1;fillColor=#E8F0E8;strokeColor=#548235;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="480" y="640" width="380" height="290" as="geometry"/></mxCell>
        <mxCell id="v1b3" value="&lt;b&gt;peach_lifecycle_manager&lt;/b&gt;&lt;br&gt;（= nav2_lifecycle_manager）&lt;br&gt;名单：场景 → 重建 → 技能 → 调度&lt;br&gt;bond_timeout 默认 0&lt;br&gt;（死检走 HeartbeatWatchdog）&lt;br&gt;+ peach_lifecycle_flag_bridge&lt;br&gt;→ managed_nodes_activated（开批闸门）&lt;br&gt;PAUSE = 节点 Inactive，非批次暂停" style="rounded=1;html=1;fillColor=#E8F0E8;strokeColor=#548235;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="890" y="640" width="420" height="290" as="geometry"/></mxCell>
        <mxCell id="v1b4" value="&lt;b&gt;peach_observability（只读横切，不进名单）&lt;/b&gt;&lt;br&gt;8090 作业票 / 调试操作面（不发运动、不 SetIO）&lt;br&gt;会话 bag runs/session_*（MCAP 限速）+ 账本&lt;br&gt;+ 停栈 bag_report&lt;br&gt;/diagnostics 四层：L1 /rosout → L2 事件/账本&lt;br&gt;→ L3 diagnostics → L4 runs/session_*&lt;br&gt;契约 peach_interfaces（IDL + manifest）&lt;br&gt;库 peach_common（不跑节点）" style="rounded=1;html=1;fillColor=#E8E3F5;strokeColor=#7B5EA7;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#1F3864;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1340" y="640" width="520" height="290" as="geometry"/></mxCell>

        <mxCell id="v1note" value="不变量：R1 跨层只经 peach_interfaces；R2 数据单向（唯一反向=CheckReachability IK 查询）；R5 纯核零 ROS；R6 运动收敛授权矩阵、能力绑 Active。数据链：RGB-D → 感知（事实）→ 重建（模型 + GraspDecision）→ 调度（选果/FSM/账本）→ 臂（运动）。禁止：感知发运动、技能写账本、用 grasp_decision 选果。" style="text;html=1;fontSize=11;fontColor=#1F3864;align=left;verticalAlign=top;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="24" y="950" width="1836" height="60" as="geometry"/></mxCell>

        <mxCell id="v1e1" value="/camera/* RGB-D · TF@stamp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4B5A6B;strokeWidth=1.5;fontSize=10;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v1h1" target="v1p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="95"/><mxPoint x="452" y="95"/></Array></mxGeometry></mxCell>

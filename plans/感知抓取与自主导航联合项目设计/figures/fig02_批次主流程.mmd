%% PNG 按 A4 版心网格绘制，勿用 mmdc 覆盖
flowchart TB
  subgraph COL1[到位与选定]
    direction TB
    A[人工开批] --> B[L1 作业位靠近]
    B -->|失败| X[中止本批]
    B -->|成功| C[场景观察锁定]
    C --> D[选定当前颗]
  end
  subgraph COL2[靠近套入与收口]
    direction TB
    E[L2 目标靠近]
    E -->|失败| Y[放弃本颗]
    E -->|可抓取| F[近距重建]
    F -->|无许可| Y
    F -->|有许可| G[套入]
    G --> H{末端B}
    H -->|否 方案A| I[记账]
    H -->|是| J{姿态门}
    J -->|通过| I
    J -->|不通过| Y
    I --> K{下一项}
    Y --> K
    K -->|结束| Z[本批结束]
  end
  D --> E
  K -->|再观察| C
  K -->|下一颗| D

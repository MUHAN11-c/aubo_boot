{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Noto Sans CJK SC, Microsoft YaHei, sans-serif",
    "fontSize": "14px",
    "primaryColor": "#D6E4F0",
    "primaryTextColor": "#1F3864",
    "primaryBorderColor": "#2F5496",
    "lineColor": "#2F5496",
    "secondaryColor": "#FFF2CC",
    "tertiaryColor": "#E2EFDA",
    "clusterBkg": "#F7F9FC",
    "clusterBorder": "#2F5496",
    "actorBkg": "#D6E4F0",
    "actorBorder": "#2F5496",
    "actorTextColor": "#1F3864",
    "signalColor": "#2F5496",
    "signalTextColor": "#1F3864",
    "labelBoxBkgColor": "#FFF2CC",
    "labelBoxBorderColor": "#2F5496",
    "labelTextColor": "#1F3864"
  },
  "flowchart": {
    "curve": "basis",
    "padding": 10,
    "htmlLabels": true,
    "nodeSpacing": 18,
    "rankSpacing": 26,
    "useMaxWidth": true
  },
  "sequence": {
    "actorMargin": 28,
    "messageMargin": 36,
    "mirrorActors": false
  }
}

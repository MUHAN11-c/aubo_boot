%% PREGRASP_ONLY 真机测试 — 判断与执行（对照源码，非摘要）
%% 权威：docs/testing.md、task_executor_node.py、behavior_tree.xml、cycle.cpp
flowchart TD
  start([人工启动]) --> pgrep{pgrep 残留 launch/container?}
  pgrep -->|有| kill[按 PID 停干净]
  pgrep -->|无| launch
  kill --> launch
  launch["ros2 launch harvest_system<br/>hardware_mode=real camera=true<br/>robot_ip=169.254.10.98<br/>launch 不发 RunHarvest"]
  launch --> dash{起了 aubo_dashboard?}
  dash -->|是| abort0[停栈：禁止]
  dash -->|否| smoke

  subgraph smoke [冒烟门]
    smoke[lifecycle 六节点 Active] --> js["/joint_states 六关节名"]
    js --> rs{"robot_status<br/>e_stopped=0 且 motion_possible=1?"}
    rs -->|否| waitTeach[示教器上电/消急停]
    rs -->|是| cam["相机 ~2.4 FPS"]
    cam --> tf{"wrist3→camera_link<br/>≈[0.045,0.108,0.002]<br/>不是名义 2cm?"}
    tf -->|名义| abortTF[停：手眼 active.yaml]
    tf -->|现场外参| web[8090 /api/state=200]
  end

  web --> params
  subgraph params [运行期档位 不改 yaml 默认]
    params["param set 顺序"] --> pe[skills execution.enabled=true]
    pe --> pg{grasp 且 execution?}
    pg -->|否| rejectParam[onParameters 拒：依赖链]
    pg -->|是| pg2[grasp.enabled=true]
    pg2 --> pt{tool.enabled?}
    pt -->|true| abortTool[本轮禁止 SetIO]
    pt -->|false 保持| ex[executor execution_enabled=true]
    ex --> ppo{execute_pregrasp_only?}
    ppo -->|false| abortFull[会走套入 本轮不要]
    ppo -->|true 默认| rh
  end

  rh["RunHarvest intent=0 PICK_ALL<br/>新 request_id 避免续旧账本"] --> fsm

  subgraph fsm [调度 FSM]
    fsm --> nav{navigation_enabled?}
    nav -->|true| navAct[NavigateToWorksite + 静止]
    nav -->|false 默认| begin[BeginScene]
    navAct -->|arrived| begin
    navAct -->|失败| termNav[termination=navigate_failed]
    begin -->|accepted| survey[SurveyScene PTP 拍照位]
    begin -->|拒| termBegin[begin_scene_failed]
    survey --> en{execution_enabled?}
    en -->|否| settleOff[Survey 后结算]
    en -->|是| sel
    sel[SELECT next_target_id] --> skipFruit{"confirmed<br/>且未 claimed<br/>且锁定集<br/>且 strategy 不含 fruit<br/>且 obs.diagnostic_flags<br/>无 unbagged_display_only?"}
    skipFruit -->|否| empty{连续空扫 ≥ empty_survey_limit=2?}
    empty -->|否| survey2[再 Survey]
    survey2 --> sel
    empty -->|是| settleEmpty[结算]
    skipFruit -->|是 claimed| recov0
    recov0{技能 recovery 待 ACK?} -->|是| waitAck0[停：ACK 命令6]
    recov0 -->|否| disp[DISPATCH]
  end

  subgraph dispG [DISPATCH = Build ∥ OBSERVE_ONLY]
    disp --> lock{"2.5s 内 target 在锁定集?"}
    lock -->|否| skipNL[SKIPPED_QUALITY target_not_in_locked_set]
    lock -->|是| build[BuildTargetModel]
    build --> bstart{"2s 内进入 COLLECTING?"}
    bstart -->|否| skipBST[build_start_timeout]
    bstart -->|是| obs[ExecuteTarget OBSERVE_ONLY]
    obs --> skillsGoal{"Active 且非 running<br/>且非 recovery<br/>且锁定集命中?"}
    skillsGoal -->|拒×4| skipRej[observe_only rejected]
    skillsGoal -->|受理| btObs
  end

  subgraph btObs [BT OBSERVE_ONLY]
    btObs[PrepareCycle] --> planOnly{execution.enabled?}
    planOnly -->|否| preview[只规划视点 不运动]
    planOnly -->|是| skipObs{skip_observation?}
    skipObs -->|否| acq[AcquireReconstructionViews]
    acq --> cur[当前位采帧]
    cur --> base{"基线/覆盖过门?"}
    base -->|否| ptp{"短 PTP ≤2 次<br/>且 IK 成功?"}
    ptp -->|失败/穷尽| finGate{finalize_gate.allowed?}
    finGate -->|否| skipUR[SKIPPED_UNREACHABLE 扫描上限]
    finGate -->|是| waitRef
    ptp -->|到位| waitFr[等新鲜观测+新机位]
    waitFr -->|超时无新机位| ptp
    base -->|是| waitRef
    waitRef{等到绑定目标精化?} -->|否| skipOR[observe_only 未精化]
    waitRef -->|是| obsOK[OBSERVE SUCCEEDED]
  end

  obsOK --> waitB{"Build 成功<br/>且 views≥reconstruction_min_views=2?"}
  waitB -->|否| skipRace[observe_build_view_race / build_failed]
  waitB -->|是| full[EXECUTE PREGRASP_ONLY skip_observation=true]

  subgraph btPre [BT PREGRASP_ONLY]
    full --> po2{IsPlanOnly?}
    po2 -->|是| preview2[预览]
    po2 -->|否| skipO2{skip_observation?}
    skipO2 -->|是| qv[FinalizeAndValidate]
    skipO2 -->|否| acq2[再观察]
    acq2 --> qv
    qv --> gready{"refined 到达<br/>且 quality_gate.readyToGrasp<br/>且 GraspDecision.allowed<br/>且 decision.target_id==cycle?"}
    gready -->|否| skipGD["SKIPPED_QUALITY<br/>禁止降级接触"]
    gready -->|是| obsOnly{IsObserveOnly?}
    obsOnly -->|是| reportO[ReportObserveOnly]
    obsOnly -->|否| gdis{grasp.enabled?}
    gdis -->|否| reportG[ReportReadyForGrasp 不到预抓取]
    gdis -->|是| recon[ReconfirmTarget]
    recon --> stale{allow_stale_anchor?}
    stale -->|true| movePG
    stale -->|false 默认| fresh{"新鲜观测<br/>身份/漂移/摆动过门?"}
    fresh -->|否| skipRC[SKIPPED_QUALITY 再确认]
    fresh -->|是| movePG[MovePregrasp MTC/PTP]
    movePG -->|规划/护栏/执行失败| skipUR2[SKIPPED_UNREACHABLE 或 FAILED]
    movePG -->|到位| ver[VerifyPregrasp]
    ver --> tex{execution.enabled?}
    tex -->|否| skipRes[跳过残差]
    tex -->|是| twoF["两帧工具 TF 间隔 200ms ×最多3次<br/>frames_deg&lt;1.5°<br/>轴夹角≤2.0°<br/>侧向≤3mm"]
    twoF -->|过| hold[HoldPregrasp]
    twoF -->|未过且可修正| corr[短修正 moveToPregrasp]
    corr --> twoF
    twoF -->|仍未过| skipPR[PREGRASP_RESIDUAL]
    hold --> recov[contact_recovery_required<br/>不回 harvest_stow 不套入 不 SetIO]
  end

  recov --> complete[CompleteTarget SUCCEEDED grasped=false]
  complete --> fsmWait[调度 Command.NONE → _wait_recovery]
  fsmWait --> ack["人工目视后 ControlTask 命令6"]
  ack --> selNext[才允许再 Survey / 下一颗]
  selNext --> sel

  skipNL & skipBST & skipRej & skipUR & skipOR & skipRace & skipGD & skipRC & skipUR2 & skipPR --> ledger[ledger.json 写 failure_code]
  ledger --> sel

  settleOff & settleEmpty & termNav & termBegin --> endBatch([批次结束 停写 jsonl])
  ack -.-> endBatch

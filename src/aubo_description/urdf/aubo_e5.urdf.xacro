<?xml version="1.0"?>
<robot name="aubo_e5" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Keep the vendor arm definition isolated from workcell accessories. -->
  <xacro:include filename="aubo_e5.urdf"/>
  <xacro:include filename="components/table.xacro"/>
  <xacro:include filename="components/camera.xacro"/>
  <xacro:include filename="components/quick_changer.xacro"/>
  <xacro:include filename="components/tcp_shear_v1.xacro"/>
  <xacro:include filename="components/tcp_bite_shear_v1.xacro"/>
  <xacro:include filename="components/tcp_adaptive_shear_v1.xacro"/>
  <xacro:include filename="aubo_e5.ros2_control.xacro"/>

  <xacro:arg name="include_table" default="true"/>
  <xacro:arg name="include_camera" default="true"/>
  <xacro:arg name="include_quick_changer" default="true"/>
  <!-- hardware_mode: mock (GenericSystem + JTC) | real (AuboE5Hardware + passthrough) -->
  <xacro:arg name="hardware_mode" default="mock"/>
  <xacro:arg name="robot_ip" default="169.254.10.98"/>
  <!-- tool_profile: adaptive_shear_v1 (自适应剪切手+IMU，默认) | bite_shear_v1 (咬合式)
       | shear_v1 (剪切手)。三个独立 if（非 if/else）：未知 profile 名三支都不展开
       → 缺 tcp 帧，启动即失败。 -->
  <xacro:arg name="tool_profile" default="adaptive_shear_v1"/>
  <xacro:property name="tool_profile" value="$(arg tool_profile)"/>

  <xacro:aubo_e5_ros2_control
    name="AuboE5System"
    hardware_mode="$(arg hardware_mode)"
    robot_ip="$(arg robot_ip)"/>

  <xacro:if value="$(arg include_table)">
    <xacro:aubo_e5_table parent="world"/>
  </xacro:if>
  <xacro:if value="$(arg include_camera)">
    <xacro:aubo_e5_camera parent="wrist3_Link"/>
    <xacro:if value="$(arg include_quick_changer)">
      <xacro:aubo_e5_quick_changer parent="camera_body_link"/>
    </xacro:if>
  </xacro:if>
  <!-- 末端 TCP 固定关节（URDF 内建，robot_state_publisher 发布，见 components/tcp_<profile>.xacro；
       帧名冻结，三把剪切手仅 tool_axis 原点/姿态与网格不同） -->
  <xacro:if value="${tool_profile == 'shear_v1'}">
    <xacro:aubo_e5_tcp_shear_v1 parent="wrist3_Link"/>
  </xacro:if>
  <xacro:if value="${tool_profile == 'bite_shear_v1'}">
    <xacro:aubo_e5_tcp_bite_shear_v1 parent="wrist3_Link"/>
  </xacro:if>
  <xacro:if value="${tool_profile == 'adaptive_shear_v1'}">
    <xacro:aubo_e5_tcp_adaptive_shear_v1 parent="wrist3_Link"/>
  </xacro:if>
</robot>

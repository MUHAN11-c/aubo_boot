<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 2026-09-28 起本链接保留为帧（名冻结：SRDF/ACM/octomap 豁免名单按名消费），不再挂几何——
       快换盘对与等高垫块已并入各 profile 的 tool_body_link（一次导出方式，见 tcp.xacro）。 -->
  <xacro:macro name="aubo_e5_quick_changer" params="parent:=camera_body_link">
    <link name="quick_changer_link">
      <inertial>
        <origin xyz="-0.00074639 0.000074616 0.0097884" rpy="0 0 0"/>
        <mass value="0.21939"/>
        <inertia ixx="6.3771e-05" ixy="4.2875e-07" ixz="-1.7848e-07"
                 iyy="6.9400e-05" iyz="-4.5085e-07" izz="0.0001149"/>
      </inertial>
    </link>

    <joint name="quick_changer_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="quick_changer_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>

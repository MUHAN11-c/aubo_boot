<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="aubo_e5_quick_changer" params="parent:=camera_body_link">
    <link name="quick_changer_link">
      <inertial>
        <origin xyz="-0.00074639 0.000074616 0.0097884" rpy="0 0 0"/>
        <mass value="0.21939"/>
        <inertia ixx="6.3771e-05" ixy="4.2875e-07" ixz="-1.7848e-07"
                 iyy="6.9403e-05" iyz="-4.5085e-07" izz="0.0001149"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://aubo_description/meshes/visual/tools/quick_changer.stl"/>
        </geometry>
        <material name="quick_changer_gray">
          <color rgba="0.82 0.82 0.82 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://aubo_description/meshes/collision/tools/quick_changer.stl"/>
        </geometry>
      </collision>
    </link>

    <joint name="quick_changer_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="quick_changer_link"/>
      <origin xyz="0 0 0.0215" rpy="0 0 3.1416"/>
    </joint>
  </xacro:macro>
</robot>

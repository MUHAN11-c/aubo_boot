<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 自适应空心圆柱工具 adaptive_cylinder_v1：挂增量 IMU（serial_imu 挂 tcp 对齐），
       筒体被动柔顺适配果袋；套入期间臂姿态经 imu_follow 跟随 IMU 弥补视觉误差。
       TCP 在圆柱顶部（开口），机械尺寸 (x=0, y=47mm, z=168.66mm) in wrist3_Link，
       其余（姿态 Rx(-90°)、外径、筒长、刀口）与 hollow_cylinder_v1 相同。
       几何档案：aubo_description/config/adaptive_cylinder_v1.yaml（改几何两处同改） -->
  <xacro:include filename="tcp.xacro"/>
  <xacro:macro name="aubo_e5_tcp_adaptive_cylinder_v1" params="parent:=wrist3_Link">
    <xacro:aubo_e5_tcp parent="${parent}" tcp_xyz="0 0.047 0.16866"/>
  </xacro:macro>
</robot>

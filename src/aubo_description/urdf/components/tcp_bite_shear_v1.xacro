<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 咬合式剪切手（bite_shear_v1）包装：双刀口对夹剪断果柄，喉道导轨（220mm）引导果枝；
       TCP=刀口区设计参考点 (0, 30.24, 165.5) mm（总装系测量核定：ΔY 30.24 / ΔZ 165.5 /
       距离 168.24，2026-09-28 用户核定）；开口 +Y（Rx(−90°)，果侧进枝，与全工具族同向）。
       档案：config/bite_shear_v1.yaml；网格 meshes/{visual,collision}/tools/bite_shear_v1.stl。 -->
  <xacro:include filename="tcp.xacro"/>
  <xacro:macro name="aubo_e5_tcp_bite_shear_v1" params="parent:=wrist3_Link">
    <xacro:aubo_e5_tcp parent="${parent}"
        tcp_xyz="0 0.03024 0.1655" tcp_rpy="-1.5708 0 0"
        sleeve_mouth_z="0.0" mesh_stem="bite_shear_v1"
        body_rgba="0.62 0.65 0.68 1.0"/>
  </xacro:macro>
</robot>

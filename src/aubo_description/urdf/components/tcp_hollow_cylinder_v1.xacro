<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 固定空心圆柱剪切工具 hollow_cylinder_v1：
       TCP 在圆柱顶部（开口），机械尺寸 (x=0, y=47.90mm, z=151.07mm) in wrist3_Link。
       几何档案：aubo_description/config/hollow_cylinder_v1.yaml（改几何两处同改） -->
  <xacro:include filename="tcp.xacro"/>
  <xacro:macro name="aubo_e5_tcp_hollow_cylinder_v1" params="parent:=wrist3_Link">
    <xacro:aubo_e5_tcp parent="${parent}" tcp_xyz="0 0.0479 0.15107"/>
  </xacro:macro>
</robot>

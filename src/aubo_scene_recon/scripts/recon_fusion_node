#!/usr/bin/env bash
# 用项目 venv 跑节点（需要 open3d）。
# 约定：venv 一律经 `source bin/activate` 激活后使用；若操作者已自行
# `source aubo_py3.12/bin/activate`（或别的 venv），则直接沿用当前环境。
# 也可用 AUBO_PYTHON 显式指定解释器（优先级最高，跳过激活）。
set -euo pipefail
if [[ -n "${AUBO_PYTHON:-}" ]]; then
  exec "${AUBO_PYTHON}" -m aubo_scene_recon.fusion_node "$@"
fi
if [[ -z "${VIRTUAL_ENV:-}" ]]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # install/.../lib/aubo_scene_recon → 工作区根（上四级）
  WS="$(cd "${SCRIPT_DIR}/../../../.." && pwd)"
  ACTIVATE="${WS}/aubo_py3.12/bin/activate"
  if [[ ! -f "${ACTIVATE}" ]]; then
    echo "[aubo_scene_recon] 找不到 venv 激活脚本: ${ACTIVATE}" >&2
    echo "请先: aubo_py3.12/bin/pip install 'open3d==0.19.0'" >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "${ACTIVATE}"
fi
exec python3 -m aubo_scene_recon.fusion_node "$@"

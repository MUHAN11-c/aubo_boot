# =============================================================================
# MoveToPose.srv — 运动到目标位姿服务（高级封装）
# 服务方: ivg_demo_services 的 move_service_node（/move_to_pose）
# 调用方: Web 调试面板 / 上位机
# =============================================================================
geometry_msgs/Pose target_pose    # 目标TCP位姿（位置+四元数），仅 use_joints=false 时使用；单位：米
float64[6] target_joints          # 目标6个关节角度（rad），仅 use_joints=true 时使用；须在关节限位内
bool use_joints                   # true=关节空间运动（MoveJ），false=笛卡尔空间运动（MoveL，TCP 直线）
float32 velocity_factor           # 速度倍率 (0,1.0]；0 回退 joint_limits.yaml 默认；>1 截断为 1.0
float32 acceleration_factor       # 加速度倍率 (0,1.0]；同上
---
bool success      # true=成功到达目标位姿
int32 error_code  # 0=成功，非零=具体错误类型（详见日志）
string message    # 状态消息或错误信息

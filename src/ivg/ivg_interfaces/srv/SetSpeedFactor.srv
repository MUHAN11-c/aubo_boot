# =============================================================================
# SetSpeedFactor.srv — 设置演示栈默认速度倍率
# 服务方: ivg_demo_services 的 move_service_node（/set_speed_factor）
#         仅作用于本节点后续 /move_to_pose 等运动请求的 MoveIt 缩放因子，
#         不改变透传控制器硬件限速。
# 调用方: Web 调试面板
# =============================================================================
float32 velocity_factor  # 速度倍率 (0,1.0]；0=恢复默认 0.5；>1 截断为 1.0
---
bool success    # true=设置成功
string message  # 状态消息或错误信息

  </include>
  <include>
    <uri>model://apple</uri>
    <name>obj_05_apple</name>
    <pose>0.050000 0.020000 0.750000 0 0 0.000000</pose>
  </include>
  <include>
    <uri>model://cracker_box</uri>
    <name>obj_06_cracker_box</name>
    <pose>0.280000 0.180000 0.750000 0 0 0.174533</pose>
  </include>
  <include>
    <uri>model://sugar_box</uri>
    <name>obj_07_sugar_box</name>

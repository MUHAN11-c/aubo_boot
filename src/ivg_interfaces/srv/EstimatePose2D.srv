# =============================================================================
# EstimatePose2D.srv — 2D 姿态估计服务
# 用途：对输入 RGB 图像进行 2D 物体检测与姿态估计，返回图像坐标系中的中心坐标、旋转角度和置信度。
# 调用方：上位机任务调度节点、视觉检测节点、调试面板
# 服务方：ivg_pose_estimation 节点（服务名 estimate_pose_2d）
# 说明：与 EstimatePose 的 3D 位姿估计不同，此服务仅进行 2D 图像层面的检测，
#       适用于不需要深度信息的检测场景（如目标定位+偏转角检测），
#       旋转角度范围：0°~360°（度），基于模板的朝向匹配。
# =============================================================================

# ======================== 请求字段 ========================
sensor_msgs/Image image     # 输入的待处理 RGB 图像，编码类型通常为 "rgb8" 或 "bgr8"
string object_id            # 目标物体模板 ID，用于选择要匹配的模板库，
                            # 如 "coffee_cup_top", "milk_box_front" 等

---
# ======================== 响应字段 ========================
int32 success_num            # 识别成功数量（检测到的目标实例数），0=未检测到目标
float32[] center_x           # 每个检测目标中心的 X 坐标，单位：像素（px），
                             # 相对于图像左上角原点
float32[] center_y           # 每个检测目标中心的 Y 坐标，单位：像素（px），
                             # 相对于图像左上角原点
float32[] rotation_angle     # 每个检测目标的旋转角度，单位：度（deg），范围：0~360
float32[] confidence         # 每个检测结果的置信度，范围：[0, 1.0]，
                             # 值越高表示匹配越可靠
sensor_msgs/Image vis_image  # 可视化结果图像，包含在原始图像上叠加绘制的检测框（矩形框）
                             # 和中心点标记，用于调试显示
string message               # 识别状态信息，包含处理结果描述或失败原因

# =============================================================================
# ListTemplates.srv — 模板列表查询服务
# 用途：查询当前模板库中注册的所有模板 ID 及其对应的工件 ID 列表。
# 调用方：Web Dashboard 模板管理界面、调试节点
# 服务方：ivg_pose_estimation 节点（服务名 list_templates）
# 说明：可选参数 workpiece_id 用于筛选特定工件的所有模板，
#       通过此服务可以获取当前可用的模板列表，用于 EstimatePose 和 EstimatePose2D 的 object_id 参数，
#       模板通过 StandardizeTemplate 服务注册到模板库中。
# =============================================================================

# ======================== 请求字段 ========================
string workpiece_id  # 工件 ID（可选），用于筛选返回特定工件的模板列表；
                     # 如果为空字符串或未设置，则返回所有工件的所有模板

---
# ======================== 响应字段 ========================
bool success          # 是否成功获取到模板列表
string error_message  # 错误消息（如果失败），包含失败原因描述
string[] template_ids  # 模板 ID 列表，每个模板唯一标识一个注册的模板，
                       # 格式如 ["coffee_cup_top", "milk_box_front", ...]
string[] workpiece_ids # 工件 ID 列表，与 template_ids 一一对应，
                       # 标识每个模板所属的工件类型

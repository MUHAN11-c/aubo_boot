# =============================================================================
# StandardizeTemplate.srv — 模板标准化服务
# 用途：对指定工件 ID 的原始 CAD/扫描模板数据进行标准化处理（姿态归一化、过滤无效姿态、统一格式）喵~
# 调用方：Web Dashboard 模板管理界面、调试节点
# 服务方：visual_pose_estimation 的 pose_estimation_server 节点
# 说明：标准化过程包括：将原始模板姿态转换为标准坐标系、去除重复或无效姿态、
#       过滤掉不可达的抓取姿态、验证 IK 可行性等喵~
#       标准化后的模板可直接用于 EstimatePose 和 EstimatePose2D 的匹配识别喵~
#       processed_count 和 skipped_count 可用于评估模板数据的质量喵~
#       跳过原因通常包括：位姿超出机器人工作空间、位姿导致自碰撞、位姿与已有模板重复等喵~
# =============================================================================

# ======================== 请求字段 ========================
string workpiece_id  # 工件 ID，指定要标准化的目标工件，如 "coffee_cup", "milk_box"，
                     # 对应的原始模板数据必须已经导入至模板库中喵~

---
# ======================== 响应字段 ========================
bool success             # 是否成功完成模板标准化喵~
string error_message     # 错误消息（如果失败），包含失败原因描述喵~
int32 processed_count    # 成功处理的姿态数量（通过标准化验证的有效姿态数）喵~
int32 skipped_count      # 跳过的姿态数量（不符合标准化规则而剔除的姿态数）喵~
string[] processed_pose_ids  # 成功处理并加入标准模板库的姿态 ID 列表喵~
string[] skipped_pose_ids    # 被跳过的姿态 ID 列表，可用于后续人工检查和恢复喵~

# =============================================================================
# UpdateParams.srv — 动态更新参数服务
# 用途：在运行时动态更新视觉处理管线中各个模块（预处理器、特征提取器、姿态估计器）的配置参数喵~
# 调用方：Web Dashboard 参数调优界面、调试节点、自适应控制节点
# 服务方：visual_pose_estimation 的 pose_estimation_server 节点
# 说明：参数更新后立即生效，无需重启节点喵~
#       支持热更新，适合在运行时对视觉检测参数进行实时调优喵~
#       可更新的参数段（section）包括：
#       - "preprocessor": 预处理参数（降噪阈值、滤波核大小等）喵~
#       - "feature_extractor": 特征提取参数（特征点阈值、描述子类型等）喵~
#       - "pose_estimator": 姿态估计参数（匹配阈值、迭代次数等）喵~
#       params_json 的键值对格式取决于对应模块的实现，需参考各模块文档喵~
# =============================================================================

# ======================== 请求字段 ========================
string section        # 参数段名称，指定要更新参数的模块：
                      # "preprocessor" = 预处理模块参数，
                      # "feature_extractor" = 特征提取模块参数，
                      # "pose_estimator" = 姿态估计模块参数喵~
string params_json    # 参数 JSON 字符串，格式：{"key1": value1, "key2": value2, ...}，
                      # key 为参数名，value 为参数值（支持数字、字符串、布尔、数组类型）喵~

---
# ======================== 响应字段 ========================
bool success   # 是否成功更新参数：true=参数更新成功，false=更新失败（参数名不存在或值类型不匹配等）喵~
string message # 状态消息或错误信息，包含更新结果的详细描述喵~

<?xml version="1.0" ?>
<!--ivg_sim 抓取执行 SRDF（v3：原厂 AUBO E5 + gripper2 剖分四指爪）。
    组名/KDL/关节限位与 aubo_e5_moveit_config 同构（其 yaml 直接复用）；
    链 tip=tcp（指端包络腔心，法兰下 0.2365m）。碰撞对含本包独有 link
    （pedestal/g2_base/finger_*），不引用 peach 工具 link。-->
<robot name="aubo_e5">
    <group name="manipulator_e5">
        <chain base_link="base_link" tip_link="tcp" />
    </group>
    <group_state name="home" group="manipulator_e5">
        <joint name="shoulder_joint" value="0" />
        <joint name="upperArm_joint" value="-0.0334" />
        <joint name="foreArm_joint" value="1.236" />
        <joint name="wrist1_joint" value="-0.3675" />
        <joint name="wrist2_joint" value="1.5701" />
        <joint name="wrist3_joint" value="0" />
    </group_state>
    <disable_collisions link1="base_link" link2="shoulder_Link" reason="Adjacent" />
    <disable_collisions link1="base_link" link2="upperArm_Link" reason="Never" />
    <disable_collisions link1="base_link" link2="pedestal_link" reason="Adjacent" />
    <disable_collisions link1="foreArm_Link" link2="upperArm_Link" reason="Adjacent" />
    <disable_collisions link1="foreArm_Link" link2="wrist1_Link" reason="Adjacent" />
    <disable_collisions link1="shoulder_Link" link2="upperArm_Link" reason="Adjacent" />
    <disable_collisions link1="shoulder_Link" link2="wrist1_Link" reason="Never" />
    <disable_collisions link1="wrist1_Link" link2="wrist2_Link" reason="Adjacent" />
    <disable_collisions link1="wrist1_Link" link2="wrist3_Link" reason="Never" />
    <disable_collisions link1="wrist2_Link" link2="wrist3_Link" reason="Adjacent" />
    <disable_collisions link1="wrist3_Link" link2="camera_Link" reason="Adjacent" />
    <disable_collisions link1="wrist3_Link" link2="g2_base_link" reason="Never" />
    <disable_collisions link1="wrist3_Link" link2="tcp" reason="Adjacent" />
    <disable_collisions link1="camera_Link" link2="kuaihuan_Link" reason="Adjacent" />
    <disable_collisions link1="camera_Link" link2="g2_base_link" reason="Never" />
    <disable_collisions link1="kuaihuan_Link" link2="g2_base_link" reason="Adjacent" />
    <disable_collisions link1="kuaihuan_Link" link2="tcp" reason="Never" />
    <disable_collisions link1="g2_base_link" link2="finger_xp_link" reason="Adjacent" />
    <disable_collisions link1="g2_base_link" link2="finger_xn_link" reason="Adjacent" />
    <disable_collisions link1="g2_base_link" link2="finger_yp_link" reason="Adjacent" />
    <disable_collisions link1="g2_base_link" link2="finger_yn_link" reason="Adjacent" />
    <disable_collisions link1="g2_base_link" link2="tcp" reason="Never" />
    <disable_collisions link1="finger_xp_link" link2="finger_xn_link" reason="Default" />
    <disable_collisions link1="finger_yp_link" link2="finger_yn_link" reason="Default" />
    <disable_collisions link1="finger_xp_link" link2="finger_yp_link" reason="Never" />
    <disable_collisions link1="finger_xp_link" link2="finger_yn_link" reason="Never" />
    <disable_collisions link1="finger_xn_link" link2="finger_yp_link" reason="Never" />
    <disable_collisions link1="finger_xn_link" link2="finger_yn_link" reason="Never" />
    <disable_collisions link1="finger_xp_link" link2="tcp" reason="Never" />
    <disable_collisions link1="finger_xn_link" link2="tcp" reason="Never" />
    <disable_collisions link1="finger_yp_link" link2="tcp" reason="Never" />
    <disable_collisions link1="finger_yn_link" link2="tcp" reason="Never" />
    <disable_collisions link1="pedestal_link" link2="upperArm_Link" reason="Never" />
</robot>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>peach2_calibration</name>
  <version>2.0.0</version>
  <description>Peach v2 calibration results (single source of per-tool error constants) and, from M0 on, bench calibration tools (hand-eye, TCP, blade plane, capture band, IO counter-proof).</description>
  <maintainer email="wjz@example.com">wjz</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>aubo_description</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

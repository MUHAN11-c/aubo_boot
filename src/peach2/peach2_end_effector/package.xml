<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>peach2_end_effector</name>
  <version>2.0.0</version>
  <description>Peach v2 sleeve-cutter end effectors: tool profile loading, blade state machine with independent feedback, IO backends and pluginlib tool plugins.</description>
  <maintainer email="wjz@example.com">wjz</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>

  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>

  <depend>aubo_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>aubo_description</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

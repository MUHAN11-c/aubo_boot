<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>peach_executor</name>
  <version>0.1.0</version>
  <description>
    批次调度：显式 RunHarvest 串联导航适配、感知、臂技能；
    账本、lifecycle、整栈 launch；同包只读 Web/JSONL 不发运动。
    现行只接通感知抓取（固定座；NavigateToWorksite 预留）。
  </description>
  <maintainer email="2155413529@qq.com">wjz</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <build_depend>generate_parameter_library_py</build_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>aubo_e5_bringup</exec_depend>
  <exec_depend>aubo_msgs</exec_depend>
  <exec_depend>generate_parameter_library_py</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>peach_interfaces</exec_depend>
  <exec_depend>peach_manipulation</exec_depend>
  <exec_depend>peach_perception</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

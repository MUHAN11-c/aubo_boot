  <joint name="right1_joint" type="continuous">
    <parent link="base_link" />
    <child link="right1_link" />
    <origin xyz="0.065 -0.59797 -0.315" rpy="1.5708 0 0" />
    <axis xyz="0 0 -1" />
    <!-- 同 joint1：continuous 关节补 <limit>，避免控制器解析 URDF 限值时段错误 -->
    <limit effort="100" velocity="10" />
    <hardware>
      <motorType>None</motorType>
      <motorDirection>1</motorDirection>
      <armature>0</armature>
    </hardware>
  </joint>

  <joint name="right2_joint" type="continuous">
    <parent link="base_link" />
    <child link="right2_link" />
    <origin xyz="-0.205 -0.59797 -0.315" rpy="1.5708 0 0" />
    <axis xyz="0 0 -1" />
    <!-- 同 joint1：continuous 关节补 <limit>，避免控制器解析 URDF 限值时段错误 -->
    <limit effort="100" velocity="10" />
    <hardware>
      <motorType>None</motorType>
      <motorDirection>1</motorDirection>
      <armature>0</armature>
    </hardware>
  </joint>

  <joint name="left1_joint" type="continuous">
    <parent link="base_link" />
    <child link="left1_link" />
    <origin xyz="0.065 0.59797 -0.315" rpy="1.5708 0 0" />
    <axis xyz="0 0 -1" />
    <!-- 同 joint1：continuous 关节补 <limit>，避免控制器解析 URDF 限值时段错误 -->
    <limit effort="100" velocity="10" />
    <hardware>
      <motorType>None</motorType>
      <motorDirection>1</motorDirection>
      <armature>0</armature>
    </hardware>
  </joint>

  <joint name="left2_joint" type="continuous">
    <parent link="base_link" />
    <child link="left2_link" />
    <origin xyz="-0.205 0.59797 -0.315" rpy="1.5708 0 0" />
    <axis xyz="0 0 -1" />
    <!-- 同 joint1：continuous 关节补 <limit>，避免控制器解析 URDF 限值时段错误 -->
    <limit effort="100" velocity="10" />
    <hardware>
      <motorType>None</motorType>
      <motorDirection>1</motorDirection>
      <armature>0</armature>
    </hardware>
  </joint>

  <joint name="joint1" type="revolute">
    <parent link="base_link" />
    <child link="link1" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <!-- 实物限位 ±180°（连续旋转会缠绕线缆）；速度为仿真占位限值，待实测替换 -->
    <limit lower="-3.1416" upper="3.1416" effort="100" velocity="1.5" />
    <hardware>
      <motorType>None</motorType>
      <motorDirection>1</motorDirection>
      <armature>0</armature>
    </hardware>
  </joint>

  <joint name="joint2" type="prismatic">
    <parent link="link1" />
    <child link="link2" />
    <origin xyz="0 0 0.4425" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="0.3" effort="100" velocity="0.25" /><!-- 仿真占位限值 -->
    <hardware>
      <motorType>None</motorType>
      <motorDirection>1</motorDirection>
      <armature>0</armature>
    </hardware>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="link2" />
    <child link="link3" />
    <origin xyz="0.1065 0 0.8392" rpy="0 1.5708 0" />
    <axis xyz="0 0 -1" />
    <limit lower="-0.8" upper="0.5" effort="100" velocity="1.5" /><!-- 仿真占位限值 -->
    <hardware>
      <motorType>None</motorType>
      <motorDirection>1</motorDirection>
      <armature>0</armature>
    </hardware>
  </joint>

  <joint name="joint4" type="prismatic">
    <parent link="link3" />
    <child link="link4" />
    <origin xyz="-0.031 0 -0.1065" rpy="-1.5708 -1.5708 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.5" upper="0.15" effort="100" velocity="0.25" /><!-- 仿真占位限值 -->
    <hardware>
      <motorType>None</motorType>
      <motorDirection>1</motorDirection>
      <armature>0</armature>
    </hardware>
  </joint>

  <joint name="joint5" type="revolute">
    <parent link="link4" />
    <child link="link5" />
    <origin xyz="-0.0009997 -0.0104 0.63294" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="0.5" upper="3.6" effort="100" velocity="3.0" /><!-- 仿真占位限值 -->
    <hardware>
      <motorType>None</motorType>
      <motorDirection>1</motorDirection>
      <armature>0</armature>
    </hardware>
  </joint>

  <joint name="joint6" type="revolute">
    <parent link="link5" />
    <child link="link6" />
    <origin xyz="0 0 0.261" rpy="1.5708 0 1.1255" />
    <axis xyz="0 0 1" />
    <limit lower="-1" upper="1" effort="100" velocity="3.0" /><!-- 仿真占位限值 -->
    <hardware>
      <motorType>None</motorType>
      <motorDirection>1</motorDirection>
      <armature>0</armature>
    </hardware>
  </joint>

  <!-- 末端工具坐标系（TCP）：相对 link6（joint6 坐标系）零姿态偏移
       x=47.9 mm, y=230.066 mm, z=0 mm（2026-08-04 实测给定），
       夹爪/吸盘换装或重测后修改 tool0_joint 的 origin -->
  <link name="tool0"/>

  <joint name="tool0_joint" type="fixed">
    <parent link="link6"/>
    <child link="tool0"/>
    <origin xyz="0.0479 0.230066 0" rpy="0 0 0"/>
  </joint>

</robot>
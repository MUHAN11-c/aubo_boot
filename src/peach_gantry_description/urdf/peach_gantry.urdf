    <inertial>
      <origin xyz="0 0 -0.08047" rpy="0 0 0" />
      <mass value="2.1306" />
      <inertia ixx="0.0033864" ixy="0" ixz="0" iyy="0.0033864" iyz="0" izz="0.0043308" />

uint8 PREVIEW=0
uint8 OBSERVE_ONLY=1
uint8 FULL=2

string request_id
string run_id
string cycle_id
string target_id
uint8 mode
---
uint8 SUCCEEDED=0
uint8 SKIPPED_QUALITY=1
uint8 SKIPPED_UNREACHABLE=2
uint8 FAILED=3
# 周期被取消（操作员跳过/暂停/立即取消）：能力端在 goal canceled 终局填本值，
# 编排器据 outcome 判别取消语义（result.code 仅作旧版能力端兼容兜底）。
uint8 CANCELED=4

uint8 outcome
string reason
bool recovery_required
# 周期阶段耗时埋点（重构阶段 C）：stage_names 与 stage_durations 为等长并行数组，
# stage_names[i] 是阶段名（小写串），stage_durations[i] 是该阶段墙钟累计耗时。
# 合法阶段名集合：prepare / observe / finalize / reconfirm / approach_insert /
# tool / retreat。语义约定：
#   - 只记录本周期实际经历的阶段，按首次进入顺序排列，未经历的阶段不出现；
#   - 同名阶段多次进入时累计到同一桶（如 observe 跨多个视点的
#     MOVE_TO_VIEW/WAIT_FRAME 往返）；
#   - prepare 为周期受理到首次进入后续阶段的隐式段（btPrepareCycle 等准备工作）；
#   - reconfirm 为抓取前再确认段（2.7-RECONFIRM，CycleState::RECONFIRM 投影，
#     allow_stale_anchor=true 跳过再确认时该段不出现）；
#   - 取消/失败终局同样填充已历经阶段；goal 未真正启动（受理即失败）时两数组为空。
builtin_interfaces/Duration[] stage_durations
string[] stage_names
---
peach_harvest_msgs/HarvestState state

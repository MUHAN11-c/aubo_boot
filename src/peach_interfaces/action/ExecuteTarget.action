# 对当前 target_id 跑一周期（观察 / 预抓取 / 套入）。
# 动作：/peach_arm/execute_target
# 服务端：peach_arm    客户端：peach_executor（调度是唯一动作客户端）
# PREGRASP_ONLY 为现行默认干跑：到预抓取停住、不回 harvest_stow、任何路径不 SetIO；
# ACK 后调度才 Survey / 派下一颗。套入须 GraspDecision.allowed。

# === Goal ===
uint8 PREVIEW=0                # 只规划接触，不执行
uint8 OBSERVE_ONLY=1           # 只补视角，给重建凑机位
uint8 FULL=2                   # 观察可跳过 + 套入/刀/撤退（须 execute_pregrasp_only=false）
uint8 PREGRASP_ONLY=3          # 到预抓取并验证后停住；不 SetIO、不回 stow

string request_id              # 批次 request_id
string run_id                  # 批次 run_id
string cycle_id                # 单颗周期 ID（通常 run_id:target_id）
string target_id               # 须与 HarvestState.target_id 一致
uint8 mode                     # PREVIEW / OBSERVE_ONLY / FULL / PREGRASP_ONLY
bool skip_observation          # FULL 时可跳过观察段
uint32 scene_epoch             # 须与当前 BeginScene 世代一致
string model_revision          # 期望模型修订；空=非预览执行须拒
string tool_profile_id         # 工具剖面
string calibration_revision    # 标定修订；空=非预览执行须拒
string config_revision         # 配置修订；空=非预览执行须拒
string plan_id                 # 预览与执行须同一计划对象
uint64 generation              # 动作事务世代；迟到结果丢弃
# 清洁重写轮附加（阶段 2 消费；观察模式届时由大脑内化，本动作收窄为纯接触）：
uint8 PROFILE_PREGRASP_HOLD=0  # 停预抓取检查点（不 SetIO、不回 stow；须 ACK）
uint8 PROFILE_FULL=1           # 全程套入 / 剪切 / 撤退
# 阶段检查点（阶段 2 起 feedback.checkpoint 取值；均 abortable——取消即透传 abort + RobotMoveStop）
uint8 CK_AT_STAGING=1          # 到 staging 停位
uint8 CK_AT_PREGRASP=2         # 到预抓取（PREGRASP_HOLD 终点）
uint8 CK_SLEEVE_PLANNED=3      # 套入与反向撤退规划过门
uint8 CK_SLEEVED=4             # 套入到位
uint8 CK_CUT_ACCEPTED=5        # SetIO 受理（≠切断）
uint8 CK_CUT_CONFIRMED=6       # 切断确认（刀具 DI / 电流特征）
uint8 CK_RETAINED=7            # 承接确认（DI 预留 / 操作台目视）
uint8 CK_RETREATED=8           # 原路撤回预抓取
uint8 CK_STOWED=9              # 回 harvest_stow
peach_interfaces/Clearance clearance   # 接触许可令牌（TOOL/CONTACT 级复检输入）
uint8 profile                  # PROFILE_*；0 与 PREGRASP_ONLY 语义衔接
---
# === Result ===
uint8 SUCCEEDED=0              # 周期完成（采摘成功另看 harvest.grasped）
uint8 SKIPPED_QUALITY=1        # 质量不够
uint8 SKIPPED_UNREACHABLE=2    # 不可达
uint8 FAILED=3                 # 接触或工具失败
uint8 CANCELED=4               # 取消

uint8 LEVEL_NONE=0                   # 尚未到达预抓取
uint8 LEVEL_PREGRASP_REACHED=1       # 已到预抓取停位（残差可未过门）
uint8 LEVEL_PREGRASP_VERIFIED=2      # 新目标观测+工具到位且残差过门
uint8 LEVEL_SLEEVE_COMPLETED=3       # 套入完成
uint8 LEVEL_CUT_COMMAND_ACCEPTED=4   # 刀指令已受理
uint8 LEVEL_CUT_CONFIRMED=5          # 切断已确认
uint8 LEVEL_RETREAT_CONFIRMED=6      # 撤退已确认
uint8 LEVEL_HARVEST_CONFIRMED=7      # 采摘确认（切断证据+撤退证据）

uint8 outcome                  # SUCCEEDED..CANCELED
uint8 completion_level         # LEVEL_* 最高到达档
uint32 failure_code            # FailureCode.*；0=NONE
string reason                  # 稳定原因码
bool recovery_required         # true=须人工 ACK 才允许下一颗（PREGRASP_ONLY 停住亦然）
bool cut_command_accepted      # 刀指令已受理
bool cut_confirmed             # 切断已确认（无硬件反馈时不得仅凭指令置 true）
bool retreat_confirmed         # 撤退已确认
bool harvest_confirmed         # 切断且撤退确认
builtin_interfaces/Duration[] stage_durations  # 与 stage_names 等长的各阶段耗时
string[] stage_names           # 阶段名（观察/预抓取/套入/刀/撤退等）
peach_interfaces/HarvestResult harvest           # 接触段抓取结果
peach_interfaces/DepositResult deposit           # 卸果；未标定则 deposited=false
peach_interfaces/Verification verification       # 周期校验块
peach_interfaces/TargetOutcome outcome_record    # 入账用终局
peach_interfaces/PregraspVerification pregrasp   # 技能用工具 TF 自填的残差（不是订重建话题）
---
# === Feedback ===
peach_interfaces/HarvestState state  # 周期进行中的批次快照镜像
uint8 checkpoint               # CK_*（阶段 2 起）；0=尚未到首个检查点

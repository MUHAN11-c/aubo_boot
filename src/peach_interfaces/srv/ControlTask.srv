# 人工控制批次。服务端 peach_executor ~/control。
# 客户端：调度（自动流）与 Web 调试操作面（鉴权+默认关，见 io.md §5.3）。
# expected_state_seq 须等于当前 HarvestState.state_seq（0=不检查），防过期点击。

uint8 PAUSE=0                 # 非接触段立即停；接触段标 PAUSE_PENDING
uint8 RESUME=1
uint8 ENTER_MAINTENANCE=2
uint8 EXIT_MAINTENANCE=3
uint8 CANCEL_NOW=4            # 级联取消在途动作并结算
uint8 SKIP_TARGET=5           # 跳过当前目标（记 target_operator_skipped）
uint8 ACKNOWLEDGE_RECOVERY=6  # 接触或 PREGRASP_ONLY 停住 ACK；技能确认成功才消耗 state_seq

string request_id
uint64 expected_state_seq     # 0 或不匹配则拒绝（ACK 失败不消耗序号）
uint8 command                 # 上列常量；须出现在 HarvestState.permissions 中
string reason                 # 人读原因，写入事件
---
bool accepted
string message                # 拒绝原因（mismatch / not permitted / ...）
uint64 state_seq              # 处理后的序号
peach_interfaces/HarvestState state

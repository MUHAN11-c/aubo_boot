<?xml version="1.0" encoding="UTF-8"?>
<!-- 套袋桃：预抓取验证 →（PREGRASP_ONLY 停住不回 stow）套入 → 剪切 → 原路撤退。 -->
<root BTCPP_format="4" main_tree_to_execute="PeachHarvest">
  <BehaviorTree ID="ObserveScan">
    <Sequence name="observe_scan">
      <AcquireReconstructionViews/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="QualityValidate">
    <Sequence name="quality_validate">
      <FinalizeAndValidate/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="MoveAndVerifyPregrasp">
    <Sequence name="move_verify_pregrasp">
      <ReconfirmTarget/>
      <MovePregrasp/>
      <VerifyPregrasp/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="SleeveCutRetreat">
    <Sequence name="sleeve_cut_retreat">
      <PlanSleeveAndReverseRetreat/>
      <SleeveLinear/>
      <VerifyCutHold/>
      <ActuateCutter/>
      <VerifyCut/>
      <ExecuteReservedReverseRetreat/>
      <ReturnHarvestStow/>
      <VerifyHarvestOutcome/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="PeachHarvest">
    <Sequence name="harvest_cycle">
      <PrepareCycle/>
      <Fallback name="preview_or_active_cycle">
        <Sequence>
          <IsPlanOnly/>
          <PlanObservationPreview/>
        </Sequence>
        <Sequence>
          <Fallback name="observe_or_skip">
            <IsSkipObservation/>
            <SubTree ID="ObserveScan"/>
          </Fallback>
          <SubTree ID="QualityValidate"/>
          <Fallback name="report_or_grasp">
            <Sequence>
              <IsObserveOnly/>
              <ReportObserveOnly/>
            </Sequence>
            <Sequence>
              <IsGraspDisabled/>
              <ReportReadyForGrasp/>
            </Sequence>
            <Sequence>
              <SubTree ID="MoveAndVerifyPregrasp"/>
              <Fallback name="pregrasp_or_contact">
                <Sequence>
                  <IsPregraspOnly/>
                  <HoldPregrasp/>
                </Sequence>
                <SubTree ID="SleeveCutRetreat"/>
              </Fallback>
              <CompleteTarget/>
            </Sequence>
          </Fallback>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>
</root>

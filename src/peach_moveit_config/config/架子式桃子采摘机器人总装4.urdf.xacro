<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="架子式桃子采摘机器人总装4">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import 架子式桃子采摘机器人总装4 urdf file -->
    <xacro:include filename="$(find peach_gantry_description)/urdf/peach_gantry.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="架子式桃子采摘机器人总装4.ros2_control.xacro" />


    <xacro:架子式桃子采摘机器人总装4_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>

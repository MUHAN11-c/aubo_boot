#!/usr/bin/env bash
# 用项目 venv 跑节点（需要 torch/ultralytics）。
# 约定：venv 一律经 `source bin/activate` 激活后使用；若操作者已自行
# `source aubo_py3.12/bin/activate`（或别的 venv），则直接沿用当前环境。
# 也可用 AUBO_PYTHON 显式指定解释器（优先级最高，跳过激活）。
set -euo pipefail
if [[ -n "${AUBO_PYTHON:-}" ]]; then
  exec "${AUBO_PYTHON}" -m peach_pose_ros2.peach_pose_node "$@"
fi
if [[ -z "${VIRTUAL_ENV:-}" ]]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # install/.../lib/peach_pose_ros2 → 工作区根（上四级）
  WS="$(cd "${SCRIPT_DIR}/../../../.." && pwd)"
  ACTIVATE="${WS}/aubo_py3.12/bin/activate"
  if [[ ! -f "${ACTIVATE}" ]]; then
    echo "[peach_pose_ros2] 找不到 venv 激活脚本: ${ACTIVATE}" >&2
    echo "请先按 README 安装依赖: aubo_py3.12/bin/pip install torch ultralytics" >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "${ACTIVATE}"
fi
exec python3 -m peach_pose_ros2.peach_pose_node "$@"

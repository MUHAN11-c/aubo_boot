<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- AUBO E5 臂链快照（拷自 aubo_description/urdf/aubo_e5.urdf，2026-10-13 P2）。

  为什么拷贝而不 include：aubo_e5.urdf 末尾的 world link + world_joint 会把
  base_link 焊死在世界系——统一机体需要 platform_base_link 作根、臂挂车体
  顶面，驱动九包只读不可改（ivg_description/urdf/base.xacro 同款先例）。
  同步口径：mesh 仍 package://aubo_description/... 只读引用；关节限位/惯量
  以 aubo_description 为准，改动须人工同步本文件。不含 world link/joint。 -->
  <xacro:macro name="aubo_e5_arm_chain">
    <link name="base_link">
      <inertial>
        <origin xyz="-1.4795E-13 0.0015384 0.020951" rpy="0 0 0"/>
        <mass value="0.83419"/>
        <inertia ixx="0.0014414" ixy="7.8809E-15" ixz="8.5328E-16"
                 iyy="0.0013542" iyz="-1.4364E-05" izz="0.0024659"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/visual/link0.dae"/>
        </geometry>
        <material name="aubo_grey"><color rgba="0.82 0.82 0.82 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/collision/link0.stl"/>
        </geometry>
      </collision>
    </link>

    <link name="shoulder_Link">
      <inertial>
        <origin xyz="3.2508868974735E-07 0.00534955349296065 -0.00883689325611056" rpy="0 0 0"/>
        <mass value="1.57658348693919"/>
        <inertia ixx="0.0040640448663128" ixy="0" ixz="0"
                 iyy="0.00392863238466817" iyz="-0.000160151642851425"
                 izz="0.0030869857349184"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/visual/link1.dae"/>
        </geometry>
        <material name="aubo_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/collision/link1.stl"/>
        </geometry>
      </collision>
    </link>

    <joint name="shoulder_joint" type="revolute">
      <origin xyz="0 0 0.122" rpy="0 0 3.1416"/>
      <parent link="base_link"/>
      <child link="shoulder_Link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.05" upper="3.05" effort="100" velocity="3.14"/>
    </joint>

    <link name="upperArm_Link">
      <inertial>
        <origin xyz="0.203996646979614 2.01304585036544E-10 0.0127641545395984" rpy="0 0 0"/>
        <mass value="4.04175782265494"/>
        <inertia ixx="0.00965399211106204" ixy="0" ixz="0"
                 iyy="0.144993869035655" iyz="0" izz="0.142607184039966"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/visual/link2.dae"/>
        </geometry>
        <material name="aubo_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/collision/link2.stl"/>
        </geometry>
      </collision>
    </link>

    <joint name="upperArm_joint" type="revolute">
      <origin xyz="0 0.1215 0" rpy="-1.5708 -1.5708 0"/>
      <parent link="shoulder_Link"/>
      <child link="upperArm_Link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.05" upper="3.05" effort="100" velocity="3.14"/>
    </joint>

    <link name="foreArm_Link">
      <inertial>
        <origin xyz="0.188922115560337 6.78882434739072E-07 0.0981026740461557" rpy="0 0 0"/>
        <mass value="2.27145669098343"/>
        <inertia ixx="0.00214322284946289" ixy="0" ixz="-0.00073120631553383"
                 iyy="0.0443926090878205" iyz="0" izz="0.0441273797128365"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/visual/link3.dae"/>
        </geometry>
        <material name="aubo_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/collision/link3.stl"/>
        </geometry>
      </collision>
    </link>

    <joint name="foreArm_joint" type="revolute">
      <origin xyz="0.408 0 0" rpy="-3.1416 -5.1632E-18 -5.459E-16"/>
      <parent link="upperArm_Link"/>
      <child link="foreArm_Link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.05" upper="3.05" effort="100" velocity="3.14"/>
    </joint>

    <link name="wrist1_Link">
      <inertial>
        <origin xyz="7.54205137428592E-07 0.0062481254331257 -0.00392367464072373" rpy="0 0 0"/>
        <mass value="0.500477539188764"/>
        <inertia ixx="0.00071194605962081" ixy="0" ixz="0"
                 iyy="0.00040588242872958" iyz="-2.30808694377512E-05"
                 izz="0.000685574904861334"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/visual/link4.dae"/>
        </geometry>
        <material name="aubo_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/collision/link4.stl"/>
        </geometry>
      </collision>
    </link>

    <joint name="wrist1_joint" type="revolute">
      <origin xyz="0.376 0 0" rpy="3.1416 -1.8323E-15 1.5708"/>
      <parent link="foreArm_Link"/>
      <child link="wrist1_Link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.05" upper="3.05" effort="100" velocity="3.14"/>
    </joint>

    <link name="wrist2_Link">
      <inertial>
        <origin xyz="-7.54207620578635E-07 -0.00624812542617262 -0.00392367464115684" rpy="0 0 0"/>
        <mass value="0.500477539245988"/>
        <inertia ixx="0.00071194605981829" ixy="0" ixz="0"
                 iyy="0.000405882428755442" iyz="2.30808694515886E-05"
                 izz="0.000685574005112107"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/visual/link5.dae"/>
        </geometry>
        <material name="aubo_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/collision/link5.stl"/>
        </geometry>
      </collision>
    </link>

    <joint name="wrist2_joint" type="revolute">
      <origin xyz="0 0.1025 0" rpy="-1.5708 -1.8709E-15 -1.6653E-16"/>
      <parent link="wrist1_Link"/>
      <child link="wrist2_Link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.05" upper="3.05" effort="100" velocity="3.14"/>
    </joint>

    <link name="wrist3_Link">
      <inertial>
        <origin xyz="3.92048778449938E-10 0.000175788057281467 -0.0213294490706684" rpy="0 0 0"/>
        <mass value="0.158309554874285"/>
        <inertia ixx="7.31376196034769E-05" ixy="0" ixz="0"
                 iyy="7.19528188876563E-05" iyz="0"
                 izz="0.000108772439051422"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/visual/link6.dae"/>
        </geometry>
        <material name="aubo_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_description/meshes/collision/link6.stl"/>
        </geometry>
      </collision>
    </link>

    <joint name="wrist3_joint" type="revolute">
      <origin xyz="0 -0.094 0" rpy="1.5708 0 1.7907E-15"/>
      <parent link="wrist2_Link"/>
      <child link="wrist3_Link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.05" upper="3.05" effort="100" velocity="3.14"/>
    </joint>
  </xacro:macro>
</robot>

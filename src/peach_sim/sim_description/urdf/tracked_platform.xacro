<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 果园采摘工位履带底盘（固定工位为 BUNKER Pro 2 彩色网格；导航为低模）。
    几何改自 Gazebo Sim 官方示例 worlds/tracked_vehicle_simple.sdf
    （gazebosim/gz-sim，Apache-2.0）。驱动是 VelocityControl：它在物理步之前
    写机体速度，接触摩擦会在同一步里把速度吃掉。接地 μ 必须接近 0，
    否则 0.5 m/s 量级的 Nav2 指令到不了里程计。
    默认尺寸即 config/orchard.yaml 的 platform.*（launch 按 yaml 注入，测试对账）。
    帧约定：platform_base_link 在两履带中线、接地平面（z=0），+X 沿行行驶方向。
    mobile:=true 时 platform_base_link 即 URDF/gz 模型根（臂链不含入——
    aubo world_joint 会把整机焊死在世界系，见 harvester_robot.urdf.xacro）；
    mobile:=false 时车体挂在臂座（parent，= base_link）下方 arm_mount_height、
    反向转台偏航，world 为模型根（SDF 保留帧名，非根会被 gz 拒建）。
    mobile:=false（默认，锚定建模轮）：整车锚在作业位，履带不可驾驶。
    mobile:=true（自主导航轮，REP-105）：履带 fixed 挂接 + box 碰撞接地，
    gz VelocityControl 直接速度驱动（P4b 起，对齐 AgileX planar_move 口径；
    原 DiffDrive+滚筒方案因各向同性 μ 侧滑已否，见下方驱动块注记）；
    OdometryPublisher 从世界位姿发 /odom 与 /tf。gz-sim 8 的子帧元素名是
    robot_base_frame（不是 robot_frame）；缺省为 {模型名}/base_footprint。
    写成 platform_base_link 后，ros_gz_bridge 把同一条 odom→platform_base_link
    桥进 ROS，不再另挂 TF 广播器；
    mobile 时转台偏航由 launch 归零，world 与 platform 同向无恒定偏差。
    前桅杆 2D 激光（±95°，车体自遮挡裁剪后）供 Nav2 使用；
    map→odom 由 AMCL/SLAM 发布，不在此 URDF。
    数值入参一律字符串进、float() 出（xacro 属性默认是字符串，直接相加会拼接）。 -->
  <xacro:macro name="peach_tracked_platform"
               params="parent arm_mount_height arm_mount_yaw_deg body_x body_y body_z body_bottom track_length track_width track_height track_separation mobile:=false chassis_visual:=''">
    <xacro:property name="mount_h" value="${float(arm_mount_height)}"/>
    <xacro:property name="mount_yaw" value="${-float(arm_mount_yaw_deg) * pi / 180.0}"/>
    <!-- 车体外観：chassis_visual 显式覆盖（'bunker'|'box'）；空串跟随 mobile
         （锚定=BUNKER 彩色网格，mobile=低模盒体）。统一机体 = bunker + 可驾驶。 -->
    <xacro:property name="bunker_visual"
                    value="${chassis_visual == 'bunker' or (chassis_visual == '' and not mobile)}"/>
    <xacro:property name="bx" value="${float(body_x)}"/>
    <xacro:property name="by" value="${float(body_y)}"/>
    <xacro:property name="bz" value="${float(body_z)}"/>
    <xacro:property name="bb" value="${float(body_bottom)}"/>
    <xacro:property name="tl" value="${float(track_length)}"/>
    <xacro:property name="tw" value="${float(track_width)}"/>
    <xacro:property name="th" value="${float(track_height)}"/>
    <xacro:property name="ts" value="${float(track_separation)}"/>
    <xacro:property name="deck_top" value="${bb + bz}"/>
    <xacro:property name="body_cz" value="${bb + bz / 2.0}"/>
    <xacro:property name="mount_cz" value="${(deck_top + mount_h) / 2.0}"/>
    <xacro:property name="mount_t" value="${mount_h - deck_top}"/>
    <xacro:property name="wheel_x" value="${tl / 2.0 - th / 2.0}"/>
    <xacro:property name="wheel_r" value="${th / 2.0}"/>

    <link name="platform_base_link">
      <inertial>
        <origin xyz="0 0 ${body_cz}" rpy="0 0 0"/>
        <mass value="120.0"/>
        <inertia ixx="4.05" ixy="0.0" ixz="0.0" iyy="12.05" iyz="0.0" izz="14.05"/>
      </inertial>
      <xacro:if value="${bunker_visual}">
        <!-- BUNKER 外观网格：带颜色的车体/履带；碰撞仍用下面的简单代理。 -->
        <visual name="bunker_chassis_visual">
          <geometry>
            <mesh filename="package://sim_description/meshes/bunker_chassis.glb"
                  scale="${bx / 1.05} ${(ts + tw) / 0.71} ${(bb + bz) / 0.54}"/>
          </geometry>
        </visual>
      </xacro:if>
      <xacro:unless value="${bunker_visual}">
        <visual name="body_visual">
          <origin xyz="0 0 ${body_cz}" rpy="0 0 0"/>
          <geometry>
            <box size="${bx} ${by} ${bz}"/>
          </geometry>
          <material name="platform_gray">
            <color rgba="0.55 0.57 0.55 1.0"/>
          </material>
        </visual>
      </xacro:unless>
      <collision name="body_collision">
        <origin xyz="0 0 ${body_cz}" rpy="0 0 0"/>
        <geometry>
          <box size="${bx} ${by} ${bz}"/>
        </geometry>
      </collision>
      <!-- 臂安装座（车体顶面 → base_link 离地高度）；mount_t≤0 时臂直接落
           车体顶面，不生成垫台（零高盒退化，gz 不收） -->
      <xacro:if value="${mount_t > 1e-9}">
        <visual name="mount_visual">
          <origin xyz="0 0 ${mount_cz}" rpy="0 0 0"/>
          <geometry>
            <box size="0.20 0.20 ${mount_t}"/>
          </geometry>
          <material name="mount_gray">
            <color rgba="0.45 0.45 0.48 1.0"/>
          </material>
        </visual>
        <collision name="mount_collision">
          <origin xyz="0 0 ${mount_cz}" rpy="0 0 0"/>
          <geometry>
            <box size="0.20 0.20 ${mount_t}"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <!-- 层级：锚定 = world（臂座，模型根）→ platform_base_link → 履带/桅杆；
       mobile/统一机体 = platform_base_link 即根（无本关节；统一机体的臂由
       外层挂到车体顶面） -->
    <xacro:unless value="${mobile}">
      <joint name="platform_mount" type="fixed">
        <parent link="${parent}"/>
        <child link="platform_base_link"/>
        <origin xyz="0 0 ${-mount_h}" rpy="0 0 ${mount_yaw}"/>
      </joint>
    </xacro:unless>

      <xacro:macro name="track_unit" params="name side">
      <link name="${name}">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="25.0"/>
          <inertia ixx="0.30" ixy="0.0" ixz="0.0" iyy="1.60" iyz="0.0" izz="1.45"/>
        </inertial>
        <xacro:if value="${mobile}">
          <visual name="${name}_visual">
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 ${pi / 2.0}"/>
            <geometry>
              <box size="${tw} ${th} ${tl}"/>
            </geometry>
            <material name="${name}_black">
              <color rgba="0.16 0.16 0.16 1.0"/>
            </material>
          </visual>
        </xacro:if>
        <!-- mobile（P4b 修正）：box 碰撞 = 履带接地印迹。VelocityControl
             直接控制机体速度（对齐 AgileX planar_move 口径），不需要滚筒
             物理滚动。圆柱滚筒方案实测侧滑 + MPPI 蛇形（各向同性 μ 下
             横向无约束），2026-10-14 用户指出后修正。 -->
        <xacro:if value="${mobile}">
          <collision name="${name}_collision">
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 ${pi / 2.0}"/>
            <geometry>
              <box size="${tw} ${th} ${tl}"/>
            </geometry>
          </collision>
        </xacro:if>
        <xacro:unless value="${mobile}">
          <collision name="${name}_collision">
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 ${pi / 2.0}"/>
            <geometry>
              <box size="${tw} ${th} ${tl}"/>
            </geometry>
          </collision>
        </xacro:unless>
      </link>
      <!-- 履带挂接：统一用 fixed——VelocityControl 不需要旋转关节
           （DiffDrive 需要 continuous 关节驱动滚筒；planar_move 口径下
           履带只是碰撞足迹 + 视觉箱体）。 -->
      <joint name="${name}_mount" type="fixed">
        <parent link="platform_base_link"/>
        <child link="${name}"/>
        <origin xyz="0 ${side * ts / 2.0} ${th / 2.0}" rpy="0 0 0"/>
      </joint>
      <!-- 接地摩擦接近 0：VelocityControl 的速度是接触求解前的初值。
           μ·g·dt（μ=150、dt=4 ms）约 6 m/s，任何导航速度都会被清零，
           控制器报 Failed to make progress。 -->
      <gazebo reference="${name}">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <fdir1>1 0 0</fdir1>
      </gazebo>
    </xacro:macro>

    <xacro:track_unit name="left_track" side="1.0"/>
    <xacro:track_unit name="right_track" side="-1.0"/>

    <xacro:if value="${mobile}">
      <!-- 前桅杆 2D 激光：z=0.45 穿树干区（干高 0.50–0.65 与棚架立柱均可见），
           FOV ±95°——车体（z 0.22–0.54，前缘 x=0.525）对后向扇区自遮挡，
           超出 ±101° 的射线会打到自身车体，这里直接不发射。 -->
      <xacro:property name="lidar_x" value="${0.5 * bx + 0.055}"/>
      <xacro:property name="lidar_z" value="${0.45}"/>
      <link name="lidar_mount">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="0.3"/>
          <inertia ixx="0.0004" ixy="0.0" ixz="0.0" iyy="0.0004" iyz="0.0" izz="0.0006"/>
        </inertial>
        <visual name="lidar_head_visual">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="0.025" length="0.035"/>
          </geometry>
          <material name="lidar_dark">
            <color rgba="0.12 0.12 0.12 1.0"/>
          </material>
        </visual>
        <collision name="lidar_head_collision">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="0.025" length="0.035"/>
          </geometry>
        </collision>
        <visual name="lidar_pole_visual">
          <!-- 触地桅杆仅视觉（低模）：不给碰撞，避免前端附加摩擦点干扰履带驱动 -->
          <origin xyz="0 0 ${-lidar_z / 2.0}" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="0.012" length="${lidar_z}"/>
          </geometry>
          <material name="lidar_dark"/>
        </visual>
      </link>
      <joint name="lidar_mount_joint" type="fixed">
        <parent link="platform_base_link"/>
        <child link="lidar_mount"/>
        <origin xyz="${lidar_x} 0 ${lidar_z}" rpy="0 0 0"/>
      </joint>
      <gazebo reference="lidar_mount">
        <sensor name="orchard_scan" type="gpu_lidar">
          <pose>0 0 0 0 0 0</pose>
          <topic>/scan</topic>
          <gz_frame_id>lidar_mount</gz_frame_id>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>190</samples>
                <resolution>1</resolution>
                <min_angle>${-95.0 * pi / 180.0}</min_angle>
                <max_angle>${95.0 * pi / 180.0}</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.25</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
        </sensor>
      </gazebo>

      <!-- 底盘驱动（P4b 修正）：VelocityControl 直接控制机体速度（对齐 AgileX
           planar_move 口径——上游 bunker_gazebo_sim 用 gazebo_ros_planar_move，
           不模拟轮子物理，轮子仅视觉）。OdometryPublisher 从世界位姿发布
           odom（无积分误差）。替换原 DiffDrive + 滚筒方案（各向同性 μ 下
           侧滑 + MPPI 蛇形，2026-10-14 用户指出后修正）。 -->
      <gazebo>
        <plugin name="gz::sim::systems::VelocityControl"
                filename="gz-sim-velocity-control-system">
          <topic>/cmd_vel</topic>
        </plugin>
      </gazebo>
      <gazebo>
        <plugin name="gz::sim::systems::OdometryPublisher"
                filename="gz-sim-odometry-publisher-system">
          <odom_topic>/odom</odom_topic>
          <tf_topic>/tf</tf_topic>
          <odom_frame>odom</odom_frame>
          <robot_base_frame>platform_base_link</robot_base_frame>
          <odom_publish_frequency>50</odom_publish_frequency>
          <dimensions>2</dimensions>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>

<?xml version="1.0"?>
<robot name="peach_harvester" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 采摘工位整机：开源履带底盘改型 + AUBO E5 + 腕载相机 + 快换 + 套袋刀。
    两模式共享 config/orchard.yaml 的 platform.* 尺寸注入（launch 按 yaml 传参）：
    mobile:=false（默认，锚定建模轮）：含完整臂链。帧契约与真机栈同构——
    `world` 与 `base_link` 由 aubo_e5.urdf 恒等连接；URDF→SDF 后 world_joint
    把整机焊在仿真世界（固定座语义，整车不可驾驶）；履带车挂 `world` 下方
    arm_mount_height、反向转台偏航。六关节由 gz JointPositionController 钉在
    真机拍照位（photo_joints，field_pregrasp_cases.yaml）。
    mobile:=true（自主导航轮，REP-105）：不含臂链（world_joint 的世界锚定
    无法在只读 aubo_description 之外解除；本轮导航不动臂）。根 =
    platform_base_link，spawn 落地 z=0；驱动 = gz DiffDrive（履带滚筒轮），
    发布 /odom 与 odom→platform_base_link TF；帧树
    map→odom→platform_base_link→{left,right}_track/lidar_mount，
    map→odom 由 Nav2 AMCL/SLAM 发布。
    不改 aubo_description 只读面；gz_ros2_control 接臂属后续轮。 -->
  <xacro:arg name="tool_profile" default="bite_shear_v1"/>
  <xacro:arg name="arm_mount_height" default="0.75"/>
  <xacro:arg name="arm_mount_yaw_deg" default="-32.0"/>
  <xacro:arg name="body_x" default="1.05"/>
  <xacro:arg name="body_y" default="0.55"/>
  <xacro:arg name="body_z" default="0.32"/>
  <xacro:arg name="body_bottom" default="0.22"/>
  <xacro:arg name="track_length" default="0.85"/>
  <xacro:arg name="track_width" default="0.15"/>
  <xacro:arg name="track_height" default="0.26"/>
  <xacro:arg name="track_separation" default="0.56"/>
  <xacro:arg name="hold_arm" default="true"/>
  <xacro:arg name="mobile" default="false"/>
  <xacro:property name="tool_profile" value="$(arg tool_profile)"/>
  <xacro:property name="mobile" value="$(arg mobile)"/>

  <xacro:include filename="tracked_platform.xacro"/>
  <xacro:unless value="${mobile}">
    <xacro:include filename="$(find aubo_description)/urdf/aubo_e5.urdf"/>
    <xacro:include filename="$(find aubo_description)/urdf/components/camera.xacro"/>
    <xacro:include filename="$(find aubo_description)/urdf/components/quick_changer.xacro"/>
    <xacro:include filename="$(find aubo_description)/urdf/components/tcp_shear_v1.xacro"/>
    <xacro:include filename="$(find aubo_description)/urdf/components/tcp_bite_shear_v1.xacro"/>
    <xacro:include filename="$(find aubo_description)/urdf/components/tcp_adaptive_shear_v1.xacro"/>
  </xacro:unless>

  <xacro:peach_tracked_platform
    parent="world"
    arm_mount_height="$(arg arm_mount_height)"
    arm_mount_yaw_deg="$(arg arm_mount_yaw_deg)"
    body_x="$(arg body_x)"
    body_y="$(arg body_y)"
    body_z="$(arg body_z)"
    body_bottom="$(arg body_bottom)"
    track_length="$(arg track_length)"
    track_width="$(arg track_width)"
    track_height="$(arg track_height)"
    track_separation="$(arg track_separation)"
    mobile="$(arg mobile)"/>

  <xacro:unless value="${mobile}">
    <xacro:aubo_e5_camera parent="wrist3_Link"/>
    <xacro:aubo_e5_quick_changer parent="camera_body_link"/>
    <!-- 三种 peach 真实末端各自展开，默认球形环抱的 bite_shear_v1。 -->
    <xacro:if value="${tool_profile == 'shear_v1'}">
      <xacro:aubo_e5_tcp_shear_v1 parent="wrist3_Link"/>
    </xacro:if>
    <xacro:if value="${tool_profile == 'bite_shear_v1'}">
      <xacro:aubo_e5_tcp_bite_shear_v1 parent="wrist3_Link"/>
    </xacro:if>
    <xacro:if value="${tool_profile == 'adaptive_shear_v1'}">
      <xacro:aubo_e5_tcp_adaptive_shear_v1 parent="wrist3_Link"/>
    </xacro:if>

    <!-- 仿真站姿：真机拍照位 photo_joints（field_pregrasp_cases.yaml） -->
    <xacro:macro name="hold_joint" params="name value">
      <gazebo>
        <plugin name="gz::sim::systems::JointPositionController"
                filename="gz-sim-joint-position-controller-system">
          <joint_name>${name}</joint_name>
          <initial_position>${value}</initial_position>
          <use_velocity_commands>1</use_velocity_commands>
          <cmd_max>1.5</cmd_max>
        </plugin>
      </gazebo>
    </xacro:macro>
    <xacro:if value="$(arg hold_arm)">
      <xacro:hold_joint name="shoulder_joint" value="0.425083"/>
      <xacro:hold_joint name="upperArm_joint" value="0.195177"/>
      <xacro:hold_joint name="foreArm_joint" value="1.677740"/>
      <xacro:hold_joint name="wrist1_joint" value="1.461739"/>
      <xacro:hold_joint name="wrist2_joint" value="-0.500161"/>
      <xacro:hold_joint name="wrist3_joint" value="0.038621"/>
    </xacro:if>
  </xacro:unless>

  <!-- 关节状态出 gz（ros_gz_bridge: gz.msgs.Model → sensor_msgs/JointState）；
       mobile 模式发布履带滚筒关节角，锚定模式发布臂关节角 -->
  <gazebo>
    <plugin name="gz::sim::systems::JointStatePublisher"
          filename="gz-sim-joint-state-publisher-system">
      <topic>/peach_sim/joint_states</topic>
    </plugin>
  </gazebo>
</robot>

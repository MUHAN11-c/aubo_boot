<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 果园采摘工位履带底盘（固定工位为 BUNKER Pro 2 彩色网格；导航为低模）。
    几何与履带摩擦参数改自 Gazebo Sim 官方示例 worlds/tracked_vehicle_simple.sdf
    的 simple_tracked 模型（gazebosim/gz-sim，Apache-2.0）：双履带 = 箱体 +
    两端圆柱，ODE 摩擦 mu 0.7 / mu2 150 / fdir1 0 1 0（横向高摩擦近似履带）。
    默认尺寸即 config/orchard.yaml 的 platform.*（launch 按 yaml 注入，测试对账）。
    帧约定：platform_base_link 在两履带中线、接地平面（z=0），+X 沿行行驶方向。
    mobile:=true 时 platform_base_link 即 URDF/gz 模型根（臂链不含入——
    aubo world_joint 会把整机焊死在世界系，见 harvester_robot.urdf.xacro）；
    mobile:=false 时车体挂在臂座（parent，= base_link）下方 arm_mount_height、
    反向转台偏航，world 为模型根（SDF 保留帧名，非根会被 gz 拒建）。
    mobile:=false（默认，锚定建模轮）：整车锚在作业位，履带不可驾驶。
    mobile:=true（自主导航轮，REP-105）：履带 = 滚筒驱动轮（continuous 关节 +
    圆柱碰撞体，盒体仅视觉），gz DiffDrive 驱动（官方 TB3/TB4 仿真同款），
    发布 /odom 与 odom→platform_base_link TF（关节积分里程计）；
    mobile 时转台偏航由 launch 归零，world 与 platform 同向无恒定偏差。
    前桅杆 2D 激光（±95°，车体自遮挡裁剪后）供 Nav2 使用；
    map→odom 由 AMCL/SLAM 发布，不在此 URDF。
    数值入参一律字符串进、float() 出（xacro 属性默认是字符串，直接相加会拼接）。 -->
  <xacro:macro name="peach_tracked_platform"
               params="parent arm_mount_height arm_mount_yaw_deg body_x body_y body_z body_bottom track_length track_width track_height track_separation mobile:=false">
    <xacro:property name="mount_h" value="${float(arm_mount_height)}"/>
    <xacro:property name="mount_yaw" value="${-float(arm_mount_yaw_deg) * pi / 180.0}"/>
    <xacro:property name="bx" value="${float(body_x)}"/>
    <xacro:property name="by" value="${float(body_y)}"/>
    <xacro:property name="bz" value="${float(body_z)}"/>
    <xacro:property name="bb" value="${float(body_bottom)}"/>
    <xacro:property name="tl" value="${float(track_length)}"/>
    <xacro:property name="tw" value="${float(track_width)}"/>
    <xacro:property name="th" value="${float(track_height)}"/>
    <xacro:property name="ts" value="${float(track_separation)}"/>
    <xacro:property name="deck_top" value="${bb + bz}"/>
    <xacro:property name="body_cz" value="${bb + bz / 2.0}"/>
    <xacro:property name="mount_cz" value="${(deck_top + mount_h) / 2.0}"/>
    <xacro:property name="wheel_x" value="${tl / 2.0 - th / 2.0}"/>
    <xacro:property name="wheel_r" value="${th / 2.0}"/>

    <link name="platform_base_link">
      <inertial>
        <origin xyz="0 0 ${body_cz}" rpy="0 0 0"/>
        <mass value="120.0"/>
        <inertia ixx="4.05" ixy="0.0" ixz="0.0" iyy="12.05" iyz="0.0" izz="14.05"/>
      </inertial>
      <xacro:unless value="${mobile}">
        <!-- BUNKER 外观网格：带颜色的车体/履带；碰撞仍用下面的简单代理。 -->
        <visual name="bunker_chassis_visual">
          <geometry>
            <mesh filename="package://peach_sim/meshes/bunker_chassis.glb"
                  scale="${bx / 1.05} ${(ts + tw) / 0.71} ${(bb + bz) / 0.54}"/>
          </geometry>
        </visual>
      </xacro:unless>
      <xacro:if value="${mobile}">
        <visual name="body_visual">
          <origin xyz="0 0 ${body_cz}" rpy="0 0 0"/>
          <geometry>
            <box size="${bx} ${by} ${bz}"/>
          </geometry>
          <material name="platform_gray">
            <color rgba="0.55 0.57 0.55 1.0"/>
          </material>
        </visual>
      </xacro:if>
      <collision name="body_collision">
        <origin xyz="0 0 ${body_cz}" rpy="0 0 0"/>
        <geometry>
          <box size="${bx} ${by} ${bz}"/>
        </geometry>
      </collision>
      <!-- 臂安装座（车体顶面 → base_link 离地高度） -->
      <visual name="mount_visual">
        <origin xyz="0 0 ${mount_cz}" rpy="0 0 0"/>
        <geometry>
          <box size="0.20 0.20 ${mount_h - deck_top}"/>
        </geometry>
        <material name="mount_gray">
          <color rgba="0.45 0.45 0.48 1.0"/>
        </material>
      </visual>
      <collision name="mount_collision">
        <origin xyz="0 0 ${mount_cz}" rpy="0 0 0"/>
        <geometry>
          <box size="0.20 0.20 ${mount_h - deck_top}"/>
        </geometry>
      </collision>
    </link>

    <!-- 层级：锚定 = world（臂座，模型根）→ platform_base_link → 履带/桅杆；
       mobile = platform_base_link 即根（无臂链、无 world 链接） -->
    <xacro:unless value="${mobile}">
      <joint name="platform_mount" type="fixed">
        <parent link="${parent}"/>
        <child link="platform_base_link"/>
        <origin xyz="0 0 ${-mount_h}" rpy="0 0 ${mount_yaw}"/>
      </joint>
    </xacro:unless>

    <xacro:macro name="track_unit" params="name side">
      <link name="${name}">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="25.0"/>
          <inertia ixx="0.30" ixy="0.0" ixz="0.0" iyy="1.60" iyz="0.0" izz="1.45"/>
        </inertial>
        <xacro:if value="${mobile}">
          <visual name="${name}_visual">
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 ${pi / 2.0}"/>
            <geometry>
              <box size="${tw} ${th} ${tl}"/>
            </geometry>
            <material name="${name}_black">
              <color rgba="0.16 0.16 0.16 1.0"/>
            </material>
          </visual>
        </xacro:if>
        <xacro:if value="${mobile}">
          <!-- mobile：滚筒碰撞体（轴 Y、半径 th/2、长 tl）——DiffDrive 关节驱动下
               平滑滚动，等效履带接地印迹；盒体仅作视觉 -->
          <collision name="${name}_collision">
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
            <geometry>
              <cylinder radius="${wheel_r}" length="${tl}"/>
            </geometry>
          </collision>
        </xacro:if>
        <xacro:unless value="${mobile}">
          <collision name="${name}_collision">
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 ${pi / 2.0}"/>
            <geometry>
              <box size="${tw} ${th} ${tl}"/>
            </geometry>
          </collision>
        </xacro:unless>
        <xacro:if value="${mobile}">
          <visual name="${name}_wheel_front">
            <origin xyz="${wheel_x} 0 0" rpy="${pi / 2.0} 0 0"/>
            <geometry>
              <cylinder radius="${wheel_r}" length="${tw}"/>
            </geometry>
            <material name="${name}_black"/>
          </visual>
        </xacro:if>
        <collision name="${name}_wheel_front_collision">
          <origin xyz="${wheel_x} 0 0" rpy="${pi / 2.0} 0 0"/>
          <geometry>
            <cylinder radius="${wheel_r}" length="${tw}"/>
          </geometry>
        </collision>
        <xacro:if value="${mobile}">
          <visual name="${name}_wheel_rear">
            <origin xyz="${-wheel_x} 0 0" rpy="${pi / 2.0} 0 0"/>
            <geometry>
              <cylinder radius="${wheel_r}" length="${tw}"/>
            </geometry>
            <material name="${name}_black"/>
          </visual>
        </xacro:if>
        <collision name="${name}_wheel_rear_collision">
          <origin xyz="${-wheel_x} 0 0" rpy="${pi / 2.0} 0 0"/>
          <geometry>
            <cylinder radius="${wheel_r}" length="${tw}"/>
          </geometry>
        </collision>
      </link>
      <!-- 履带挂接：mobile 用 continuous 转动关节当驱动轮——URDF→SDF 会把固定
           关节子链接合并进父链接（fixed-joint lumping），履带不成其为独立链接、
           无从驱动（冒烟实测固定关节时 TrackController 表面速度不出牵引）。
           锚定模式仍用固定关节。 -->
      <xacro:if value="${mobile}">
        <joint name="${name}_mount" type="continuous">
          <parent link="platform_base_link"/>
          <child link="${name}"/>
          <origin xyz="0 ${side * ts / 2.0} ${th / 2.0}" rpy="0 0 0"/>
          <axis xyz="0 1 0"/>
          <dynamics damping="0.05" friction="0.0"/>
          <limit effort="1e5" velocity="20"/>
        </joint>
      </xacro:if>
      <xacro:unless value="${mobile}">
        <joint name="${name}_mount" type="fixed">
          <parent link="platform_base_link"/>
          <child link="${name}"/>
          <origin xyz="0 ${side * ts / 2.0} ${th / 2.0}" rpy="0 0 0"/>
        </joint>
      </xacro:unless>
      <!-- 履带摩擦：gz-physics dartsim 对未显式声明的碰撞不保证默认摩擦
           （官方 TB3/TB4 轮子全部显式 <surface><friction>）。
           mobile：各向同性 mu 1/1（TB3 轮口径，无 fdir1——圆柱碰撞系里
           fdir1 会指向竖直方向、破坏滚动牵引，冒烟实测）。
           锚定：官方履带口径（fdir1 车体横向 mu 0.7 / 纵向 mu2 150）。 -->
      <xacro:if value="${mobile}">
        <gazebo reference="${name}">
          <mu1>1.0</mu1>
          <mu2>1.0</mu2>
        </gazebo>
      </xacro:if>
      <xacro:unless value="${mobile}">
        <gazebo reference="${name}">
          <mu1>0.7</mu1>
          <mu2>150</mu2>
          <fdir1>0 1 0</fdir1>
        </gazebo>
      </xacro:unless>
    </xacro:macro>

    <xacro:track_unit name="left_track" side="1.0"/>
    <xacro:track_unit name="right_track" side="-1.0"/>

    <xacro:if value="${mobile}">
      <!-- 前桅杆 2D 激光：z=0.45 穿树干区（干高 0.50–0.65 与棚架立柱均可见），
           FOV ±95°——车体（z 0.22–0.54，前缘 x=0.525）对后向扇区自遮挡，
           超出 ±101° 的射线会打到自身车体，这里直接不发射。 -->
      <xacro:property name="lidar_x" value="${0.5 * bx + 0.055}"/>
      <xacro:property name="lidar_z" value="${0.45}"/>
      <link name="lidar_mount">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="0.3"/>
          <inertia ixx="0.0004" ixy="0.0" ixz="0.0" iyy="0.0004" iyz="0.0" izz="0.0006"/>
        </inertial>
        <visual name="lidar_head_visual">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="0.025" length="0.035"/>
          </geometry>
          <material name="lidar_dark">
            <color rgba="0.12 0.12 0.12 1.0"/>
          </material>
        </visual>
        <collision name="lidar_head_collision">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="0.025" length="0.035"/>
          </geometry>
        </collision>
        <visual name="lidar_pole_visual">
          <!-- 触地桅杆仅视觉（低模）：不给碰撞，避免前端附加摩擦点干扰履带驱动 -->
          <origin xyz="0 0 ${-lidar_z / 2.0}" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="0.012" length="${lidar_z}"/>
          </geometry>
          <material name="lidar_dark"/>
        </visual>
      </link>
      <joint name="lidar_mount_joint" type="fixed">
        <parent link="platform_base_link"/>
        <child link="lidar_mount"/>
        <origin xyz="${lidar_x} 0 ${lidar_z}" rpy="0 0 0"/>
      </joint>
      <gazebo reference="lidar_mount">
        <sensor name="orchard_scan" type="gpu_lidar">
          <pose>0 0 0 0 0 0</pose>
          <topic>/scan</topic>
          <gz_frame_id>lidar_mount</gz_frame_id>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>190</samples>
                <resolution>1</resolution>
                <min_angle>${-95.0 * pi / 180.0}</min_angle>
                <max_angle>${95.0 * pi / 180.0}</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.25</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
        </sensor>
      </gazebo>

      <!-- 底盘驱动：gz DiffDrive（官方 TB3/TB4 仿真同款，gz-sim 8 URDF 路径
           验证可用）。左右履带 = 滚筒驱动轮（continuous 关节），odom 由关节
           角积分。履带表面速度方案（TrackedVehicle+TrackController）在 8.15
           URDF→SDF 路径上冒烟实测不出牵引（指令链通、整车不动），留待原生
           SDF 模型轮再试。mobile 时转台偏航归零 → world 与 platform_base_link
           同向，child_frame_id 取 platform_base_link 无恒定偏差。 -->
      <gazebo>
        <plugin name="gz::sim::systems::DiffDrive"
                filename="gz-sim-diff-drive-system">
          <left_joint>left_track_mount</left_joint>
          <right_joint>right_track_mount</right_joint>
          <wheel_separation>${ts}</wheel_separation>
          <wheel_radius>${wheel_r}</wheel_radius>
          <topic>/cmd_vel</topic>
          <odom_topic>/odom</odom_topic>
          <odom_publish_frequency>50</odom_publish_frequency>
          <tf_topic>/tf</tf_topic>
          <frame_id>odom</frame_id>
          <child_frame_id>platform_base_link</child_frame_id>
          <max_linear_acceleration>1.0</max_linear_acceleration>
          <max_linear_deceleration>1.0</max_linear_deceleration>
          <max_angular_acceleration>2.0</max_angular_acceleration>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>

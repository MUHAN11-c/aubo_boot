<source name="Depth">
    <feature name="DepthScaleUnit"></feature>
    <!-- SGBM 参与图像数：空值=设备默认（18）。2026-09-20/21 实测：残留值 2 经本文件
         无条件下发会使设备端深度大面积无效（窗内 valid ~7%，mdr ~0.35）；清空后
         恢复健康（valid ~0.47，mdr ~0.98）。本包定位=官方驱动+仅本机必要调整
         （IP/分辨率走 launch 参数），调参实验值勿留在此文件 -->
    <feature name="DepthSgbmImageNumber"></feature>
    <feature name="DepthSgbmDisparityNumber"></feature>
    <feature name="DepthSgbmDisparityOffset"></feature>
    <feature name="DepthSgbmMatchWinHeight"></feature>
    <feature name="DepthSgbmSemiParamP1"></feature>
    <feature name="DepthSgbmSemiParamP2"></feature>
    <feature name="DepthSgbmUniqueFactor"></feature>
    <feature name="DepthSgbmUniqueAbsDiff"></feature>
    <feature name="DepthSgbmUniqueMaxCost"></feature>
    <feature name="DepthSgbmHFilterHalfWin"></feature>
    <feature name="DepthSgbmMatchWinWidth"></feature>
    <feature name="DepthSgbmMedFilter"></feature>
    <feature name="DepthSgbmLRC"></feature>
    <feature name="DepthSgbmLRCDiff"></feature>
    <feature name="DepthSgbmMedFilterThresh"></feature>
    <feature name="DepthSgbmSemiParamP1Scale"></feature>
    <feature name="DepthSgpmPhaseNumber"></feature>
    <feature name="DepthSgpmPhaseScale"></feature>
    <feature name="DepthSgpmPhaseOffset"></feature>
    <feature name="DepthSgpmReferencePhaseScale"></feature>
    <feature name="DepthSgpmReferencePhaseOffset"></feature>
    <feature name="DepthSgpmEpipolarConstraintPatternScale"></feature>

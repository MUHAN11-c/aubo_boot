<!-- Scope this default writer profile to the rosbag2 PLAYER PROCESS only.
     A reliable multi-MB sample needing repair can otherwise wait for the
     default 3s heartbeat. Around a loop's sparse initial cloud that exceeds
     the viewer's refill budget. Keep recorded ROS QoS, not a second TF/data
     publisher or a longer viewer timeout. The setting applies to all replay
     observation topics, so it does not encode Peach topic names.
     Do not set RMW_FASTRTPS_USE_QOS_FROM_XML=1 for this file. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <data_writer profile_name="ros2_web_replay_writer" is_default_profile="true">
      <times>
        <heartbeatPeriod>
          <sec>0</sec>
          <nanosec>100000000</nanosec>
        </heartbeatPeriod>
      </times>
    </data_writer>
  </profiles>
</dds>

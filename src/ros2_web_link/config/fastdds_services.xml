<!-- rmw_fastrtps uses "service" only for service reply writers, after an exact
     endpoint profile lookup. Short-lived reply readers can otherwise wait for
     the default 3s reliable heartbeat, exhausting a 3s Web RPC deadline.
     This is a recovery interval, not a request retry or a latency guarantee.
     Keep normal ROS reliability/durability/history, memory, transport and
     publication mode. Do not enable RMW_FASTRTPS_USE_QOS_FROM_XML for this file.
     Scope: only the rosapi/demo processes composed by web.launch.py. External
     service servers need their own deployment profile. Other RMWs ignore it. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <data_writer profile_name="service">
      <times>
        <heartbeatPeriod>
          <sec>0</sec>
          <nanosec>100000000</nanosec>
        </heartbeatPeriod>
      </times>
    </data_writer>
  </profiles>
</dds>

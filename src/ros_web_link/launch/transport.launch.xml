<launch>
  <arg name="port" default="8765"/>
  <arg name="gateway_port" default="8095"/>
  <!-- 通信矩阵演示/验证节点：/rwl_demo/*（console.html 自检与 E2E 的被测端） -->
  <arg name="fixture" default="false"/>

  <!-- foxglove_bridge -->
  <include file="$(find-pkg-share ivg_foxglove_bridge)/launch/ivg_foxglove_bridge.launch.xml">
    <arg name="port" value="$(var port)"/>
  </include>

  <!-- 纯传输网关（无 UI 静态页；等价 rosbridge 独立启动；console.html 诊断台在 /） -->
  <executable cmd="python3 -m ros_web_link.cli $(var gateway_port) --bind 0.0.0.0 --foxglove-bridge-port $(var port)"
              output="screen" respawn="true" respawn_delay="2"/>

  <!-- fixture:=true 时起通信矩阵被测端（诊断/演示用，不进任何生产栈） -->
  <group if="$(var fixture)">
    <executable cmd="python3 -m ros_web_link.comm_fixture" output="screen"/>
  </group>
</launch>

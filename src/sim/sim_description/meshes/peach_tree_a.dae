  <library_effects>
    <effect id="leaf-effect">
      <profile_COMMON>
        <newparam sid="leaf_albedo_png-surface">
          <surface type="2D">
            <init_from>leaf_albedo_png</init_from>
          </surface>
        </newparam>
        <newparam sid="leaf_albedo_png-sampler">
          <sampler2D>
            <source>leaf_albedo_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="leaf_albedo_png-sampler"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="bark-effect">
      <profile_COMMON>
        <newparam sid="bark_albedo_png-surface">
          <surface type="2D">
            <init_from>bark_albedo_png</init_from>
          </surface>
        </newparam>
        <newparam sid="bark_albedo_png-sampler">
          <sampler2D>
            <source>bark_albedo_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="bark_albedo_png-sampler"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
    <image id="bark_albedo_png" name="bark_albedo_png">
      <init_from>bark_albedo.png</init_from>
    </image>
    <image id="leaf_albedo_png" name="leaf_albedo_png">
      <init_from>leaf_albedo.png</init_from>
    </image>
  </library_images>
  <library_materials>

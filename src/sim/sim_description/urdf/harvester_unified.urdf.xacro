<?xml version="1.0"?>
<!-- robot name 必须与 aubo_e5_moveit_config SRDF 的 robot name 一致
     （aubo_e5）：moveit rdf_loader 按 name 校验 URDF×SRDF 同体，
     不一致时 moveit_rviz_plugin 报
     "Semantic description is not specified for the same robot as the URDF"
     且 SRDF 碰撞矩阵被整包拒绝（2026-10-14 实测）。gz 实体名不受此影响
     （ros_gz_sim create -name 另给）。 -->
<robot name="aubo_e5" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 统一仿真机体（P2）：可驾驶履带底盘 + 完整 AUBO E5 臂 + 腕载相机 + peach 末端。

  与 harvester_robot.urdf.xacro（锚定/mobile 两模式互斥）不同，本文件是单一
  模型：根 = platform_base_link（REP-105）；臂链拷贝自 aubo_description（见
  aubo_e5_arm.xacro 头注释，绕开 world_joint 世界锚定）；base_link 经转台
  fixed joint 挂车体顶面（arm_mount_height，垫台逻辑同 tracked_platform）。
  驱动：履带 = gz DiffDrive 滚筒；臂 = gz_ros2_control（JSB + JTC，
  config/gz_controllers.yaml）——/joint_states 由 JSB 原生发布（AUBO 六关节
  名、sim 时间戳），不再用 gz JointStatePublisher/JointPositionController。
  相机帧链 = peach 感知契约（camera_link→{color,depth}_frame→*_optical_frame），
  wrist3→camera_link 是手眼标定 active.yaml 快照（仿真单一 TF 源 = RSP，
  不跑 extrinsics_publisher 叠帧）；腕载 rgbd gz sensor（P3 桥接进 /camera/*）。 -->
  <xacro:arg name="tool_profile" default="bite_shear_v1"/>
  <xacro:arg name="arm_mount_height" default="0.54"/>
  <xacro:arg name="arm_mount_yaw_deg" default="-32.0"/>
  <xacro:arg name="body_x" default="1.05"/>
  <xacro:arg name="body_y" default="0.55"/>
  <xacro:arg name="body_z" default="0.32"/>
  <xacro:arg name="body_bottom" default="0.22"/>
  <xacro:arg name="track_length" default="0.85"/>
  <xacro:arg name="track_width" default="0.15"/>
  <xacro:arg name="track_height" default="0.26"/>
  <xacro:arg name="track_separation" default="0.56"/>
  <xacro:arg name="wrist_camera" default="true"/>
  <xacro:property name="tool_profile" value="$(arg tool_profile)"/>
  <xacro:property name="mount_h_arg" value="$(arg arm_mount_height)"/>
  <xacro:property name="mount_yaw_arg" value="$(arg arm_mount_yaw_deg)"/>

  <xacro:include filename="tracked_platform.xacro"/>
  <xacro:include filename="aubo_e5_arm.xacro"/>
  <xacro:include filename="$(find aubo_description)/urdf/components/camera.xacro"/>
  <xacro:include filename="$(find aubo_description)/urdf/components/quick_changer.xacro"/>
  <xacro:include filename="$(find aubo_description)/urdf/components/tcp_shear_v1.xacro"/>
  <xacro:include filename="$(find aubo_description)/urdf/components/tcp_bite_shear_v1.xacro"/>
  <xacro:include filename="$(find aubo_description)/urdf/components/tcp_adaptive_shear_v1.xacro"/>

  <!-- 可驾驶履带平台（BUNKER 外观 + DiffDrive + 前桅杆激光）；platform_base_link 即根 -->
  <xacro:peach_tracked_platform
    parent="platform_base_link"
    arm_mount_height="$(arg arm_mount_height)"
    arm_mount_yaw_deg="$(arg arm_mount_yaw_deg)"
    body_x="$(arg body_x)" body_y="$(arg body_y)" body_z="$(arg body_z)"
    body_bottom="$(arg body_bottom)"
    track_length="$(arg track_length)" track_width="$(arg track_width)"
    track_height="$(arg track_height)" track_separation="$(arg track_separation)"
    mobile="true" chassis_visual="bunker"/>

  <!-- 臂链 + 转台：base_link 在车体顶面 arm_mount_height，偏航 = arm_mount_yaw_deg
       （锚定模式 platform_mount 的逆变换，作业扇区方位保持一致） -->
  <xacro:aubo_e5_arm_chain/>
  <joint name="arm_mount_joint" type="fixed">
    <parent link="platform_base_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${float(mount_h_arg)}"
            rpy="0 0 ${float(mount_yaw_arg) * pi / 180.0}"/>
  </joint>

  <!-- 真机腕载组件：相机座网格 + 快换 + 三选一 peach 末端 -->
  <xacro:aubo_e5_camera parent="wrist3_Link"/>
  <xacro:aubo_e5_quick_changer parent="camera_body_link"/>
  <xacro:if value="${tool_profile == 'shear_v1'}">
    <xacro:aubo_e5_tcp_shear_v1 parent="wrist3_Link"/>
  </xacro:if>
  <xacro:if value="${tool_profile == 'bite_shear_v1'}">
    <xacro:aubo_e5_tcp_bite_shear_v1 parent="wrist3_Link"/>
  </xacro:if>
  <xacro:if value="${tool_profile == 'adaptive_shear_v1'}">
    <xacro:aubo_e5_tcp_adaptive_shear_v1 parent="wrist3_Link"/>
  </xacro:if>

  <!-- 相机帧链（peach 感知契约，帧名与 peach_stereo/真机一致）：
       wrist3→camera_link = 手眼标定 active.yaml(import_humble_20260128) 快照；
       color/depth frame 与 camera_link 恒等；optical = REP-103 旋转
       （color→optical 数值上恰为 -π/2 0 -π/2，2026-10-13 由标定四元数换算）。 -->
  <link name="camera_link"/>
  <joint name="camera_link_joint" type="fixed">
    <parent link="wrist3_Link"/>
    <child link="camera_link"/>
    <origin xyz="0.04485209875285428 0.10840123810873628 0.0016967255768052666"
            rpy="1.422219176 -1.560927445 -3.015660872"/>
  </joint>
  <link name="camera_color_frame"/>
  <joint name="camera_color_frame_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
  </joint>
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_frame_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
  </joint>

  <!-- 腕载 rgbd gz sensor（ivg_sim 同款参数；P3 经 ros_gz_bridge 出 /camera/*）。
       必须挂 wrist3_Link 并带 <pose>：空链 camera_link 会被 URDF→SDF 的
       fixed-joint lump 连同 <gazebo> 扩展一起吞掉（实测 scene/info 无此 sensor）；
       <pose> = wrist3→camera_link 标定快照（与 camera_link_joint 同值）。
       gz_frame_id 用光学帧：桥出的图像/点云 header.frame_id 即契约帧名。 -->
  <xacro:if value="$(arg wrist_camera)">
    <gazebo reference="wrist3_Link">
      <sensor name="wrist_rgbd" type="rgbd_camera">
        <pose>0.04485209875285428 0.10840123810873628 0.0016967255768052666
              1.422219176 -1.560927445 -3.015660872</pose>
        <topic>camera/depth</topic>
        <!-- 5Hz：感知(YOLO+SAM)单帧重，10Hz 连续灌会打满 worker 队列
             （2026-10-14 过载轮实测满队丢帧 ~1k/轮）；停走式相机节拍
             5 帧级足够 min_collect_frames=60 的采集 -->
        <update_rate>5.0</update_rate>
        <gz_frame_id>camera_color_optical_frame</gz_frame_id>
        <camera name="rgbd">
          <horizontal_fov>1.203132</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.05</near><far>2.5</far></clip>
          <depth_camera><output>depths</output></depth_camera>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- 臂驱动：gz_ros2_control（JSB + JTC 见 config/gz_controllers.yaml）。
       履带驱动轮不在 ros2_control 内（gz DiffDrive 直驱，见 tracked_platform）。 -->
  <ros2_control name="PeachSimGazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="shoulder_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="upperArm_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="foreArm_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist2_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist3_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find sim_description)/config/gz_controllers.yaml</parameters>
      <hold_joints>true</hold_joints>
    </plugin>
  </gazebo>
</robot>

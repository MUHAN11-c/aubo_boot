<?xml version="1.0"?>
<sdf version="1.11">
  <!-- 无草重建整园世界（2026-10-14 起承接自主采摘全链，P4 移植轮）：
       单 GLB 视觉模型 + 不可见地面碰撞 + Sensors(ogre2) 渲染（腕载 rgbd/激光）。
       网格由 blender/export_field_to_gz.py 从重建 .blend 导出；
       GT（树位/395 袋）= reconstruction scene_manifest.json，
       导航地图与停靠位由 generate_field 生成（maps/field_*）。
       程序化 peach_orchard.sdf 保留为确定性回归世界。 -->
  <world name="field_no_grass">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <!-- 传感器渲染（腕载 rgbd / 桅杆激光；peach_orchard 同款） -->
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.95 0.93 0.90 1</ambient>
      <background>0.53 0.67 0.88 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>4</speed>
          <direction>1.2</direction>
          <humidity>0.6</humidity>
          <mean_size>0.8</mean_size>
        </clouds>
      </sky>
      <fog>
        <density>0.002</density>
        <color>0.85 0.88 0.92 1</color>
      </fog>
    </scene>
    <gui>
      <camera name="user_camera">
        <pose>0 -14 12 0 0.45 1.5708</pose>
      </camera>
    </gui>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>1 0.98 0.95 1</diffuse>
      <intensity>1.5</intensity>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.557208 -0.557208 -0.615661</direction>
    </light>
    <model name="ground_collision">
      <!-- 不可见地面碰撞：统一机体（动态）在本世界可落地站立（P2）。
           视觉地面由下方 GLB 提供；本模型仅碰撞，无视觉。 -->
      <static>true</static>
      <link name="link">
        <collision name="plane">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
        </collision>
      </link>
    </model>
    <model name="field_no_grass">
      <static>true</static>
      <link name="link">
        <visual name="orchard">
          <geometry>
            <mesh>
              <uri>model://sim_description/meshes/field_no_grass.glb</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
